{% comment %}
  Renders loading-spinner.
  Accepts:
    - class: {string} css classes to replace the default ones (optional)

  Usage:
  {% render 'loading-spinner' %}

  To avoid an unstyled first-paint flash:
  {% render 'loading-spinner', initially_hidden: true %}
{% endcomment %}

<div class="{% if class %}{{ class }}{% else %}loading__spinner hidden{% endif %}"{% if initially_hidden %} hidden{% endif %}>
  {{ 'loading-spinner.svg' | inline_asset_content }}
</div>
