{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)
  - mobile_icon_overlay: {Boolean} Render the full-screen mobile icon-search experience

  Usage:
  {% render 'header-search', input_id: 'My-Id' %}
{% endcomment %}

<details-modal class="header__search{% if mobile_icon_overlay %} header__search--tg-mobile-overlay{% endif %}">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper header__icon-close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>
    <div
      class="search-modal modal__content gradient{% if mobile_icon_overlay %} search-modal--tg-mobile-overlay{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>
      <div
        class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}"
        tabindex="-1"
      >
        {%- if mobile_icon_overlay -%}
          <button
            type="button"
            class="search-modal__back-button modal__close-button link link--text focus-inset"
            aria-label="Back"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </button>
        {%- endif -%}
        <search-form class="search-modal__form">
          <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
            <div class="field">
              <input
                class="search__input field__input"
                id="{{ input_id }}"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{% if mobile_icon_overlay %}Search by recipient or occasion{% else %}{{ 'general.search.search' | t }}{% endif %}"
              >
              <label class="{% if mobile_icon_overlay %}visually-hidden{% else %}field__label{% endif %}" for="{{ input_id }}">
                {% if mobile_icon_overlay %}Search by recipient or occasion{% else %}{{ 'general.search.search' | t }}{% endif %}
              </label>
              <input type="hidden" name="options[prefix]" value="last">
              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-reset.svg' | inline_asset_content -}}
                </span>
              </button>
              <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                <span class="svg-wrapper">
                  {{- 'icon-search.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </form>
        </search-form>
        {%- if mobile_icon_overlay -%}
          {%- assign has_tg_mobile_search_suggestions = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tg_mobile_search_term' and block.settings.term != blank -%}
              {%- assign has_tg_mobile_search_suggestions = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_tg_mobile_search_suggestions -%}
            <section class="tg-mobile-search-suggestions" aria-labelledby="TgMobileSearchSuggestions-{{ input_id }}">
              <h2 id="TgMobileSearchSuggestions-{{ input_id }}" class="tg-mobile-search-suggestions__heading">
                Popular suggestions
              </h2>
              <ul class="tg-mobile-search-suggestions__list list-unstyled" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tg_mobile_search_term' and block.settings.term != blank -%}
                    <li class="tg-mobile-search-suggestions__item" {{ block.shopify_attributes }}>
                      <a
                        class="tg-mobile-search-suggestions__link focus-inset"
                        href="{{ routes.search_url }}?q={{ block.settings.term | url_encode }}&amp;options%5Bprefix%5D=last"
                      >
                        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-search.svg' | inline_asset_content -}}</span>
                        <span>{{ block.settings.term | escape }}</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}
        {%- else -%}
          <button
            type="button"
            class="search-modal__close-button modal__close-button link link--text focus-inset"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </details>
</details-modal>
