{% comment %}
  Tg-inspired mobile navigation. The PC navigation block is the shared
  source of truth for menu content; mobile_menu_card blocks only override
  the visual treatment of individual top-level menu items.
{% endcomment %}

{%- liquid
  assign desktop_utility_count = 0
  assign desktop_social_count = 0
  assign mobile_navigation_menu = blank

  for block in section.blocks
    if block.type == 'tg_header_desktop_menu' and block.settings.menu != blank
      assign mobile_navigation_menu = block.settings.menu
    endif

    if block.type == 'tg_header_desktop_utility' and block.settings.link != blank
      assign desktop_utility_count = desktop_utility_count | plus: 1
    endif

    if block.type == 'tg_header_desktop_social' and block.settings.link != blank
      assign desktop_social_count = desktop_social_count | plus: 1
    endif
  endfor

-%}

<header-drawer
  class="tg-header-mobile-menu-host"
  data-breakpoint="tablet"
  style="
    --tg-header-mobile-menu-width: {{ section.settings.tg_header_mobile_menu_width }}vw;
    --tg-header-mobile-menu-background: {{ section.settings.tg_header_mobile_menu_background }};
    --tg-header-mobile-menu-surface: {{ section.settings.tg_header_mobile_menu_surface }};
    --tg-header-mobile-menu-text: {{ section.settings.tg_header_mobile_menu_text }};
    --tg-header-mobile-menu-accent: {{ section.settings.tg_header_mobile_menu_accent }};
    --tg-header-mobile-menu-divider: {{ section.settings.tg_header_mobile_menu_divider }};
  "
>
  <details id="Tg-Details-menu-drawer-container-{{ section.id }}" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
      aria-controls="Tg-menu-drawer-{{ section.id }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div
      id="Tg-menu-drawer-{{ section.id }}"
      class="menu-drawer motion-reduce tg-header-mobile-menu"
      aria-labelledby="Tg-menu-title-{{ section.id }}"
    >
      <div class="menu-drawer__inner-container tg-header-mobile-menu__inner">
        <div class="tg-header-mobile-menu__header">
          <span id="Tg-menu-title-{{ section.id }}" class="tg-header-mobile-menu__title">
            {{- section.settings.tg_header_mobile_menu_title | escape -}}
          </span>
          <button
            type="button"
            class="tg-header-mobile-menu__close link focus-inset"
            aria-label="{{ 'accessibility.close' | t }}"
            data-menu-drawer-close
          >
            <span class="svg-wrapper" aria-hidden="true">{{- 'tg-icon-close.svg' | inline_asset_content -}}</span>
          </button>
        </div>

        <div class="menu-drawer__navigation-container tg-header-mobile-menu__body">
          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            {%- if mobile_navigation_menu != blank and mobile_navigation_menu.links != blank -%}
              <div class="tg-header-mobile-menu__primary-navigation has-submenu">
                <ul class="tg-header-mobile-menu-grid tg-header-mobile-menu-grid--featured list-unstyled" role="list">
                  {%- for link in mobile_navigation_menu.links limit: 2 -%}
                    <li>
                      {% render 'tg-header-mobile-menu-item', link: link, link_index: forloop.index, featured: true, section: section %}
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if mobile_navigation_menu.links.size > 2 -%}
                  <ul class="tg-header-mobile-menu-grid tg-header-mobile-menu-grid--navigation list-unstyled" role="list">
                    {%- for link in mobile_navigation_menu.links offset: 2 -%}
                      {%- assign mobile_menu_position = forloop.index | plus: 2 -%}
                      <li>
                        {% render 'tg-header-mobile-menu-item', link: link, link_index: mobile_menu_position, featured: false, section: section %}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}
          </nav>

          <div class="tg-header-mobile-menu__footer">
            {%- if desktop_utility_count > 0 -%}
              <ul class="tg-header-mobile-menu-utilities list-unstyled" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tg_header_desktop_utility' and block.settings.link != blank -%}
                    <li {{ block.shopify_attributes }}>
                      <a href="{{ block.settings.link }}" class="tg-header-mobile-menu-utility focus-inset">
                        <span>{{ block.settings.title | escape }}</span>
                        <span class="svg-wrapper" aria-hidden="true">{{- 'tg-icon-chevron-right.svg' | inline_asset_content -}}</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if section.settings.tg_header_mobile_menu_show_social -%}
              <ul class="tg-header-mobile-menu-social list-unstyled" role="list">
                {%- if desktop_social_count > 0 -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'tg_header_desktop_social' and block.settings.link != blank -%}
                      {%- liquid
                        assign social_icon = 'tg-icon-facebook.svg'
                        assign social_label = block.settings.platform | capitalize
                        case block.settings.platform
                          when 'youtube'
                            assign social_icon = 'tg-icon-youtube.svg'
                            assign social_label = 'YouTube'
                          when 'instagram'
                            assign social_icon = 'tg-icon-instagram.svg'
                            assign social_label = 'Instagram'
                          when 'tiktok'
                            assign social_icon = 'tg-icon-tiktok.svg'
                            assign social_label = 'TikTok'
                          when 'twitter'
                            assign social_icon = 'icon-twitter.svg'
                            assign social_label = 'X / Twitter'
                        endcase
                        if block.settings.accessibility_label != blank
                          assign social_label = block.settings.accessibility_label
                        endif
                      -%}
                      <li {{ block.shopify_attributes }}>
                        <a href="{{ block.settings.link }}" target="_blank" rel="me noopener noreferrer" class="focus-inset" aria-label="{{ social_label | escape }}">
                          <span class="svg-wrapper" aria-hidden="true">{{- social_icon | inline_asset_content -}}</span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- if settings.social_facebook_link != blank -%}
                    <li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="me noopener noreferrer" class="focus-inset" aria-label="{{ 'general.social.links.facebook' | t }}"><span class="svg-wrapper" aria-hidden="true">{{- 'tg-icon-facebook.svg' | inline_asset_content -}}</span></a></li>
                  {%- endif -%}
                  {%- if settings.social_youtube_link != blank -%}
                    <li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="me noopener noreferrer" class="focus-inset" aria-label="{{ 'general.social.links.youtube' | t }}"><span class="svg-wrapper" aria-hidden="true">{{- 'tg-icon-youtube.svg' | inline_asset_content -}}</span></a></li>
                  {%- endif -%}
                  {%- if settings.social_instagram_link != blank -%}
                    <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="me noopener noreferrer" class="focus-inset" aria-label="{{ 'general.social.links.instagram' | t }}"><span class="svg-wrapper" aria-hidden="true">{{- 'tg-icon-instagram.svg' | inline_asset_content -}}</span></a></li>
                  {%- endif -%}
                  {%- if settings.social_tiktok_link != blank -%}
                    <li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="me noopener noreferrer" class="focus-inset" aria-label="{{ 'general.social.links.tiktok' | t }}"><span class="svg-wrapper" aria-hidden="true">{{- 'tg-icon-tiktok.svg' | inline_asset_content -}}</span></a></li>
                  {%- endif -%}
                  {%- if settings.social_twitter_link != blank -%}
                    <li><a href="{{ settings.social_twitter_link }}" target="_blank" rel="me noopener noreferrer" class="focus-inset" aria-label="{{ 'general.social.links.twitter' | t }}"><span class="svg-wrapper" aria-hidden="true">{{- 'icon-twitter.svg' | inline_asset_content -}}</span></a></li>
                  {%- endif -%}
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
