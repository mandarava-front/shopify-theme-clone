{% comment %}
  Renders the visible options associated with a cart line item.

  The cart stays compact when a line has more visible options than the global
  inline option limit. In that case, the same option rows are shown in a
  read-only dialog instead of inline.

  Accepts:
  - item: Cart line item
  - modal_id: Unique dialog id for this line and surface
  - inline_class: Class name for the inline option list
  - surface: Optional visual context (`page` or `drawer`)
  - modal_style: Optional CSS custom properties for the dialog
{% endcomment %}

{%- liquid
  assign cart_item_option_count = 0
  assign cart_item_options_inline_limit = settings.tg_cart_options_inline_limit | default: 0 | plus: 0
  assign cart_item_modal_customized_image = item.properties['_customily-thumb'] | default: item.properties['_customily-preview']
  assign cart_item_modal_image = item.image
  assign cart_item_modal_image_url = blank
  assign cart_item_modal_image_alt = item.product.title

  if cart_item_options_inline_limit < 0
    assign cart_item_options_inline_limit = 0
  endif

  if cart_item_modal_customized_image != blank
    assign cart_item_modal_image_url = cart_item_modal_customized_image
  else
    if cart_item_modal_image == blank
      assign cart_item_modal_image = item.variant.image
    endif
    if cart_item_modal_image == blank
      assign cart_item_modal_image = item.product.featured_image
    endif
    if cart_item_modal_image != blank
      assign cart_item_modal_image_url = cart_item_modal_image | image_url: width: 800
      assign cart_item_modal_image_alt = cart_item_modal_image.alt | default: item.product.title
    endif
  endif

  if item.product.has_only_default_variant == false
    for option in item.options_with_values
      assign cart_item_option_count = cart_item_option_count | plus: 1
    endfor
  endif

  for property in item.properties
    assign property_first_char = property.first | slice: 0
    if property.last != blank and property_first_char != '_'
      assign cart_item_option_count = cart_item_option_count | plus: 1
    endif
  endfor

  if item.selling_plan_allocation != null
    assign cart_item_option_count = cart_item_option_count | plus: 1
  endif
-%}

{%- if cart_item_option_count > 0 -%}
  {%- capture cart_item_option_rows -%}
    {%- if item.product.has_only_default_variant == false -%}
      {%- for option in item.options_with_values -%}
        <div class="product-option">
          <dt>{{ option.name }}:</dt>
          <dd>{{ option.value }}</dd>
        </div>
      {%- endfor -%}
    {%- endif -%}

    {%- for property in item.properties -%}
      {%- assign property_first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and property_first_char != '_' -%}
        <div class="product-option">
          <dt>{{ property.first }}:</dt>
          <dd>
            {%- if property.last contains '/uploads/' -%}
              <a
                href="{{ property.last }}"
                class="link"
                target="_blank"
                rel="noopener"
                aria-describedby="a11y-new-window-message"
              >
                {{- property.last | split: '/' | last -}}
              </a>
            {%- else -%}
              {{ property.last }}
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if cart_item_option_count > cart_item_options_inline_limit -%}
    <div class="cart-item-options cart-item-options--collapsed">
      <button
        type="button"
        class="cart-item-options__trigger"
        aria-controls="{{ modal_id }}-dialog"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-label="View {{ cart_item_option_count }} item details for {{ item.product.title | escape }}"
      >
        <span>View item details</span>
        <span class="cart-item-options__count" aria-hidden="true">({{ cart_item_option_count }})</span>
      </button>

      <cart-item-options-modal
        id="{{ modal_id }}"
        class="cart-item-options-modal{% if surface != blank %} cart-item-options-modal--{{ surface }}{% endif %}"
        {% if modal_style != blank %}style="{{ modal_style }}"{% endif %}
      >
        <div
          id="{{ modal_id }}-dialog"
          class="cart-item-options-modal__content"
          role="dialog"
          aria-modal="true"
          aria-labelledby="{{ modal_id }}-title"
          tabindex="-1"
        >
          <button
            type="button"
            class="cart-item-options-modal__close"
            data-cart-item-options-close
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>

          <div class="cart-item-options-modal__scrollable">
            <div class="cart-item-options-modal__product">
              <div class="cart-item-options-modal__product-media">
                {%- if cart_item_modal_image_url != blank -%}
                  <img
                    src="{{ cart_item_modal_image_url }}"
                    alt="{{ cart_item_modal_image_alt | escape }}"
                    loading="lazy"
                    width="320"
                    height="320"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'cart-item-options-modal__product-placeholder placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="cart-item-options-modal__product-info">
                <p class="cart-item-options-modal__eyebrow">Item details</p>
                <h2 id="{{ modal_id }}-title" class="cart-item-options-modal__title">
                  {{ item.product.title | escape }}
                </h2>
                {%- if item.variant.title != blank and item.variant.title != 'Default Title' -%}
                  <p class="cart-item-options-modal__variant">{{ item.variant.title | escape }}</p>
                {%- endif -%}
                <div class="cart-item-options-modal__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s>{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
                <p class="cart-item-options-modal__quantity">Quantity: {{ item.quantity }}</p>
              </div>
            </div>

            <div class="cart-item-options-modal__body">
              <dl class="cart-item-options-modal__list">
                {{- cart_item_option_rows -}}
              </dl>

              {%- if item.selling_plan_allocation != null -%}
                <p class="cart-item-options-modal__selling-plan">
                  {{ item.selling_plan_allocation.selling_plan.name }}
                </p>
              {%- endif -%}
            </div>
          </div>
        </div>
      </cart-item-options-modal>
    </div>
  {%- else -%}
    <dl class="{{ inline_class }}">
      {{- cart_item_option_rows -}}
    </dl>

    {%- if item.selling_plan_allocation != null -%}
      <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
