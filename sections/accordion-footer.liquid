    },
    {
      "type": "text",
      "id": "social_facebook_link",
      "label": "Facebook 链接"
    },
    {
      "type": "text",
      "id": "social_instagram_link",
      "label": "Instagram 链接"
    },
    {
      "type": "text",
      "id": "social_youtube_link",
      "label": "YouTube 链接"
    },
    {
      "type": "text",
      "id": "social_tiktok_link",
      "label": "TikTok 链接"
    },
    {
      "type": "text",
      "id": "social_twitter_link",
      "label": "X（Twitter）链接"
    },
    {
      "type": "text",
      "id": "social_pinterest_link",
      "label": "Pinterest 链接"
    },
    {
      "type": "text",
      "id": "social_snapchat_link",
      "label": "Snapchat 链接"
    },
    {
      "type": "text",
      "id": "social_tumblr_link",
      "label": "Tumblr 链接"
    },
    {
      "type": "text",
      "id": "social_vimeo_link",
      "label": "Vimeo 链接"
    },
    {
      "type": "header",
      "content": "底部内容"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "显示国家/地区选择器"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": false,
      "label": "显示政策链接"
    }
  ],
  "presets": [
    {
      "name": "手风琴页脚",
      "blocks": [
        { "type": "menu" },
        { "type": "menu", "settings": { "open_by_default": true } },
        { "type": "menu" },
        { "type": "menu" },
        { "type": "secure_payment" }
      ]
    }
  ]
}
{% endschema %}
