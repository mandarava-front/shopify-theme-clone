{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
{% assign category_alignment = section.settings.card_alignment | default: 'center' %}
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-border: {{ section.settings.border_color }}; --tg-gap: {{ section.settings.gap }}px; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; --tg-heading-size: {{ section.settings.heading_font_size }}px; --tg-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-heading-weight: {{ section.settings.heading_font_weight }}; --tg-label-size: {{ section.settings.label_font_size }}px; --tg-label-size-mobile: {{ section.settings.label_font_size_mobile }}px; --tg-label-weight: {{ section.settings.label_font_weight }};" {{ section.shopify_attributes }}>
  <div class="tg-page-width">
    {%- if section.settings.heading != blank -%}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="tg-category-rail tg-category-rail--{{ category_alignment }}" role="list">
      {%- for block in section.blocks -%}
        <a class="tg-category-rail__item" href="{{ block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url }}" role="listitem" {{ block.shopify_attributes }}>
          <span class="tg-category-rail__image">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 400 | image_tag: widths: '120, 180, 240, 320, 400', loading: 'lazy', alt: block.settings.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </span><span class="tg-category-rail__label">{{ block.settings.title | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:tg.sections.category.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:tg.settings.heading"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:tg.settings.heading_font_size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:tg.settings.heading_font_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:tg.settings.heading_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "t:tg.settings.label_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "label_font_size_mobile",
      "label": "t:tg.settings.label_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "label_font_weight",
      "label": "t:tg.settings.label_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:tg.settings.background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:tg.settings.text_color",
      "default": "#0b2a4a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:tg.settings.border_color",
      "default": "#deded8"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:tg.settings.gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:tg.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:tg.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:tg.blocks.category.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:tg.settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:tg.settings.title",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:tg.settings.collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:tg.settings.link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:tg.sections.category.name",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
