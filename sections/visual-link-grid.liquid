{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'cuszoo-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_mobile_slider = false
  if section.settings.mobile_layout == 'slider' and section.blocks.size > 2
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and section.blocks.size > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign ratio_percent = 125
    when 'landscape'
      assign ratio_percent = 75
    else
      assign ratio_percent = 100
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #Slider-{{ section.id }} .cuszoo-visual-link__media {
    --visual-link-ratio: {{ ratio_percent }}%;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <h2 class="cuszoo-section-heading inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="cuszoo-section-subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <slider-component>
      <ul
        id="Slider-{{ section.id }}"
        class="cuszoo-visual-links__grid grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down{% if show_mobile_slider or show_desktop_slider %} slider{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek cuszoo-slider--peek{% endif %}{% if show_desktop_slider %} slider--desktop{% endif %}"
        role="list"
        aria-label="{{ section.settings.title | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_collection = block.settings.collection
            assign block_image = block.settings.image | default: block_collection.featured_image
            assign block_external_image = block.settings.external_image_url
            assign block_title = block.settings.title | default: block_collection.title | default: 'Collection'
            assign block_link = block.settings.link | default: block_collection.url | default: routes.collections_url
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item{% if show_mobile_slider %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <a class="cuszoo-visual-link focus-inset" href="{{ block_link }}">
              <div class="cuszoo-visual-link__media">
                {%- if block_image != blank -%}
                  {{
                    block_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '165, 360, 533, 720, 940, 1200',
                      sizes: '(min-width: 990px) calc((100vw - 10rem) / 6), 45vw',
                      loading: 'lazy',
                      alt: block_title
                  }}
                {%- elsif block_external_image != blank -%}
                  <img
                    src="{{ block_external_image }}"
                    alt="{{ block_title | escape }}"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- if block.settings.eyebrow != blank -%}
                <span class="cuszoo-visual-link__eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              <span class="cuszoo-visual-link__title">{{ block_title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons cuszoo-visual-links__controls">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Visual link grid",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "enable_desktop_slider", "label": "Enable desktop slider", "default": false },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid_2", "label": "Two-column grid" },
        { "value": "slider", "label": "Horizontal slider" }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Visual link",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "external_image_url", "label": "External image URL" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "url", "id": "link", "label": "Custom link" },
        { "type": "text", "id": "eyebrow", "label": "Small label" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Visual link grid",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
