{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-accent: {{ section.settings.button_color }}; --tg-button-text: {{ section.settings.button_text_color }}; --tg-button-radius: {{ section.settings.button_radius }}px; --tg-button-min-height: {{ section.settings.button_min_height }}px; --tg-button-padding-vertical: {{ section.settings.button_padding_vertical }}px; --tg-button-padding-horizontal: {{ section.settings.button_padding_horizontal }}px; --tg-button-font-size: {{ section.settings.button_font_size }}px; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}><div class="tg-page-width"><div class="tg-split-promo{% if section.settings.image_position == 'right' %} tg-split-promo--media-right{% endif %}"><div class="tg-split-promo__media">{% if section.settings.desktop_image != blank %}<picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.desktop_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', loading: 'lazy', alt: section.settings.heading }}</picture>{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="tg-split-promo__content" style="background: {{ section.settings.content_background }};">{% if section.settings.eyebrow != blank %}<p class="tg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.text != blank %}<p class="tg-subheading">{{ section.settings.text | escape }}</p>{% endif %}{% if section.settings.button_label != blank %}<a class="tg-button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></div></div></section>
{% schema %}
{"name":"t:tg.sections.split_promo.name","tag":"section","class":"section","settings":[{"type":"image_picker","id":"desktop_image","label":"t:tg.settings.desktop_image"},{"type":"image_picker","id":"mobile_image","label":"t:tg.settings.mobile_image"},{"type":"select","id":"image_position","label":"t:tg.settings.image_position","options":[{"value":"left","label":"t:tg.options.left"},{"value":"right","label":"t:tg.options.right"}],"default":"left"},{"type":"text","id":"eyebrow","label":"t:tg.settings.eyebrow"},{"type":"inline_richtext","id":"heading","label":"t:tg.settings.heading"},{"type":"textarea","id":"text","label":"t:tg.settings.text"},{"type":"text","id":"button_label","label":"t:tg.settings.button_label","default":"Shop now"},{"type":"url","id":"link","label":"t:tg.settings.link"},{"type":"color","id":"background","label":"t:tg.settings.background","default":"#ffffff"},{"type":"color","id":"content_background","label":"t:tg.settings.content_background","default":"#fff1dd"},{"type":"color","id":"text_color","label":"t:tg.settings.text_color","default":"#53798b"},{"type":"color","id":"button_color","label":"t:tg.settings.button_color","default":"#ffb700"},{"type":"color","id":"button_text_color","label":"t:tg.settings.button_text_color","default":"#ffffff"},{"type":"range","id":"button_radius","label":"t:tg.settings.button_radius","min":0,"max":40,"step":1,"unit":"px","default":3},{"type":"range","id":"button_min_height","label":"t:tg.settings.button_min_height","min":36,"max":72,"step":2,"unit":"px","default":44},{"type":"range","id":"button_padding_vertical","label":"t:tg.settings.button_padding_vertical","min":4,"max":24,"step":1,"unit":"px","default":9},{"type":"range","id":"button_padding_horizontal","label":"t:tg.settings.button_padding_horizontal","min":8,"max":48,"step":2,"unit":"px","default":20},{"type":"range","id":"button_font_size","label":"t:tg.settings.button_font_size","min":10,"max":24,"step":1,"unit":"px","default":12},{"type":"range","id":"padding_top","label":"t:tg.settings.padding_top","min":0,"max":120,"step":4,"unit":"px","default":36},{"type":"range","id":"padding_bottom","label":"t:tg.settings.padding_bottom","min":0,"max":120,"step":4,"unit":"px","default":0}],"presets": [
  {
    "name": "首页默认 - 双栏促销横幅",
    "settings": {
      "image_position": "left",
      "eyebrow": "",
      "heading": "",
      "text": "",
      "button_label": "Shop now",
      "link": "",
      "background": "#ffffff",
      "content_background": "#fff1dd",
      "text_color": "#53798b",
      "button_color": "#ffb700",
      "button_text_color": "#ffffff",
      "button_radius": 3,
      "button_min_height": 44,
      "button_padding_vertical": 9,
      "button_padding_horizontal": 20,
      "button_font_size": 12,
      "padding_top": 36,
      "padding_bottom": 0
    }
  }
]}
