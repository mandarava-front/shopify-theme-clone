{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-accent: {{ section.settings.button_color }}; --tg-button-text: {{ section.settings.button_text_color }}; --tg-button-radius: {{ section.settings.button_radius }}px; --tg-button-min-height: {{ section.settings.button_min_height }}px; --tg-button-padding-vertical: {{ section.settings.button_padding_vertical }}px; --tg-button-padding-horizontal: {{ section.settings.button_padding_horizontal }}px; --tg-button-font-size: {{ section.settings.button_font_size }}px; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; --tg-eyebrow-size: {{ section.settings.eyebrow_font_size }}px; --tg-eyebrow-size-mobile: {{ section.settings.eyebrow_font_size_mobile }}px; --tg-eyebrow-weight: {{ section.settings.eyebrow_font_weight }}; --tg-heading-size: {{ section.settings.heading_font_size }}px; --tg-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-heading-weight: {{ section.settings.heading_font_weight }}; --tg-subheading-size: {{ section.settings.text_font_size }}px; --tg-subheading-size-mobile: {{ section.settings.text_font_size_mobile }}px; --tg-subheading-weight: {{ section.settings.text_font_weight }}; --tg-button-font-size-mobile: {{ section.settings.button_font_size_mobile }}px; --tg-button-font-weight: {{ section.settings.button_font_weight }};" {{ section.shopify_attributes }}><div class="tg-page-width"><div class="tg-split-promo{% if section.settings.image_position == 'right' %} tg-split-promo--media-right{% endif %}"><div class="tg-split-promo__media">{% if section.settings.desktop_image != blank %}<picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.desktop_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', loading: 'lazy', alt: section.settings.heading }}</picture>{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="tg-split-promo__content" style="background: {{ section.settings.content_background }};">{% if section.settings.eyebrow != blank %}<p class="tg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.text != blank %}<p class="tg-subheading">{{ section.settings.text | escape }}</p>{% endif %}{% if section.settings.button_label != blank %}<a class="tg-button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></div></div></section>
{% schema %}
{
  "name": "t:tg.sections.split_promo.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:tg.settings.desktop_image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:tg.settings.mobile_image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:tg.settings.image_position",
      "options": [
        {
          "value": "left",
          "label": "t:tg.options.left"
        },
        {
          "value": "right",
          "label": "t:tg.options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:tg.settings.eyebrow"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "t:tg.settings.eyebrow_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "eyebrow_font_size_mobile",
      "label": "t:tg.settings.eyebrow_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "t:tg.settings.eyebrow_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:tg.settings.heading"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:tg.settings.heading_font_size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:tg.settings.heading_font_size_mobile",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:tg.settings.heading_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:tg.settings.text"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:tg.settings.text_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "t:tg.settings.text_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "t:tg.settings.text_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:tg.settings.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:tg.settings.link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:tg.settings.background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "t:tg.settings.content_background",
      "default": "#fff1dd"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:tg.settings.text_color",
      "default": "#53798b"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "t:tg.settings.button_color",
      "default": "#ffb700"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:tg.settings.button_text_color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "t:tg.settings.button_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "button_min_height",
      "label": "t:tg.settings.button_min_height",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "t:tg.settings.button_padding_vertical",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "t:tg.settings.button_padding_horizontal",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "t:tg.settings.button_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "t:tg.settings.button_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "t:tg.settings.button_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:tg.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:tg.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:tg.sections.split_promo.name"
    }
  ]
}
{% endschema %}
