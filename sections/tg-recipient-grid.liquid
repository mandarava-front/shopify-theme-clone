{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-columns: {{ section.settings.columns }}; --tg-image-radius: {% if section.settings.image_shape == 'circle' %}50%{% else %}{{ section.settings.image_radius }}px{% endif %}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; --tg-heading-size: {{ section.settings.heading_font_size }}px; --tg-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-heading-weight: {{ section.settings.heading_font_weight }}; --tg-label-size: {{ section.settings.label_font_size }}px; --tg-label-size-mobile: {{ section.settings.label_font_size_mobile }}px; --tg-label-weight: {{ section.settings.label_font_weight }};" {{ section.shopify_attributes }}><div class="tg-page-width"><div class="tg-recipients__header">{% if section.settings.heading != blank %}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{% endif %}</div><div class="tg-recipients__grid">{% for block in section.blocks %}<a class="tg-recipient" href="{{ block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span class="tg-recipient__image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: widths: '160, 320, 600', loading: 'lazy', alt: block.settings.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</span><span class="tg-recipient__label">{{ block.settings.title | escape }}</span></a>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "t:tg.sections.recipients.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:tg.settings.heading",
      "default": "Shop By Recipient"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:tg.settings.heading_font_size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:tg.settings.heading_font_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:tg.settings.heading_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "t:tg.settings.label_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "label_font_size_mobile",
      "label": "t:tg.settings.label_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "label_font_weight",
      "label": "t:tg.settings.label_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:tg.settings.columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "t:tg.settings.image_shape",
      "options": [
        {
          "value": "circle",
          "label": "t:tg.options.circle"
        },
        {
          "value": "square",
          "label": "t:tg.options.square"
        }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:tg.settings.image_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:tg.settings.background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:tg.settings.text_color",
      "default": "#0b2a4a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:tg.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:tg.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "recipient",
      "name": "t:tg.blocks.recipient.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:tg.settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:tg.settings.title",
          "default": "For her"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:tg.settings.collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:tg.settings.link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:tg.sections.recipients.name",
      "blocks": [
        {
          "type": "recipient"
        },
        {
          "type": "recipient"
        },
        {
          "type": "recipient"
        },
        {
          "type": "recipient"
        }
      ]
    }
  ]
}
{% endschema %}
