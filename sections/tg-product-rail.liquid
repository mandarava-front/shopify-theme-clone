{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tg-sections.js' | asset_url }}" defer="defer"></script>
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-border: {{ section.settings.border_color }}; --tg-accent: {{ section.settings.button_color }}; --tg-button-text: {{ section.settings.button_text_color }}; --tg-rail-button-size: {{ section.settings.nav_button_size }}px; --tg-rail-button-radius: {{ section.settings.nav_button_radius }}px; --tg-rail-button-background: {{ section.settings.nav_button_background }}; --tg-rail-button-hover-background: {{ section.settings.nav_button_hover_background }}; --tg-rail-button-border: {{ section.settings.nav_button_border_color }}; --tg-rail-button-arrow: {{ section.settings.nav_button_arrow_color }}; --tg-rail-button-hover-arrow: {{ section.settings.nav_button_hover_arrow_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}><tg-rail class="tg-page-width tg-product-rail"><header class="custom-heading tg-page-width"><div class="heading-title">{% if section.settings.heading != blank %}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.show_view_all and section.settings.collection != blank %}<div class="link_label"><a href="{{ section.settings.collection.url }}"><span>{{ section.settings.button_label | escape }}</span></a></div>{% endif %}</div><div class="navigation-box"><div class="swiper-button-prev" tabindex="0" role="button" aria-label="{{ 'tg.a11y.previous' | t }}" aria-controls="{{ section.id }}-product-rail-track" aria-disabled="false" data-tg-scroll="-1"></div><div class="swiper-button-next" tabindex="0" role="button" aria-label="{{ 'tg.a11y.next' | t }}" aria-controls="{{ section.id }}-product-rail-track" aria-disabled="false" data-tg-scroll="1"></div></div></header><ul id="{{ section.id }}-product-rail-track" class="tg-product-rail__track" data-tg-track role="list">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.products_to_show %}<li>{% render 'card-product', card_product: product, media_aspect_ratio: section.settings.image_ratio, image_shape: 'default', show_secondary_image: section.settings.show_secondary_image, show_rating: section.settings.show_rating, lazy_load: true, section_id: section.id, quick_add: 'none', product_view_context: 'collection' %}</li>{% endfor %}{% endif %}</ul></tg-rail></section>
{% schema %}
{"name":"t:tg.sections.product_rail.name","tag":"section","class":"section","settings":[{"type":"collection","id":"collection","label":"t:tg.settings.collection"},{"type":"inline_richtext","id":"heading","label":"t:tg.settings.heading","default":"Customer favorites"},{"type":"range","id":"products_to_show","label":"t:tg.settings.products_to_show","min":2,"max":20,"step":1,"default":12},{"type":"select","id":"image_ratio","label":"t:tg.settings.image_ratio","options":[{"value":"adapt","label":"t:tg.options.adapt"},{"value":"portrait","label":"t:tg.options.portrait"},{"value":"square","label":"t:tg.options.square"}],"default":"square"},{"type":"checkbox","id":"show_secondary_image","label":"t:tg.settings.show_secondary_image","default":true},{"type":"checkbox","id":"show_rating","label":"t:tg.settings.show_rating","default":true},{"type":"checkbox","id":"show_view_all","label":"t:tg.settings.show_view_all","default":false},{"type":"text","id":"button_label","label":"t:tg.settings.button_label","default":"SHOW MORE"},{"type":"color","id":"background","label":"t:tg.settings.background","default":"#ffffff"},{"type":"color","id":"text_color","label":"t:tg.settings.text_color","default":"#18181e"},{"type":"color","id":"border_color","label":"t:tg.settings.border_color","default":"#deded8"},{"type":"color","id":"button_color","label":"t:tg.settings.button_color","default":"#ffb700"},{"type":"color","id":"button_text_color","label":"t:tg.settings.button_text_color","default":"#ffffff"},{"type":"range","id":"nav_button_size","label":"t:tg.settings.nav_button_size","min":32,"max":64,"step":1,"unit":"px","default":44},{"type":"range","id":"nav_button_radius","label":"t:tg.settings.nav_button_radius","min":0,"max":50,"step":1,"unit":"px","default":50},{"type":"color","id":"nav_button_background","label":"t:tg.settings.nav_button_background","default":"#ffffff"},{"type":"color","id":"nav_button_hover_background","label":"t:tg.settings.nav_button_hover_background","default":"#000000"},{"type":"color","id":"nav_button_border_color","label":"t:tg.settings.nav_button_border_color","default":"#d9d9d9"},{"type":"color","id":"nav_button_arrow_color","label":"t:tg.settings.nav_button_arrow_color","default":"#18181e"},{"type":"color","id":"nav_button_hover_arrow_color","label":"t:tg.settings.nav_button_hover_arrow_color","default":"#ffffff"},{"type":"range","id":"padding_top","label":"t:tg.settings.padding_top","min":0,"max":140,"step":4,"unit":"px","default":64},{"type":"range","id":"padding_bottom","label":"t:tg.settings.padding_bottom","min":0,"max":140,"step":4,"unit":"px","default":64}],"presets":[{"name":"t:tg.sections.product_rail.name"}]}
{% endschema %}
