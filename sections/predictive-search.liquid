{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- liquid
  assign suggestion_count = predictive_search.resources.queries.size | plus: predictive_search.resources.collections.size
  assign editorial_count = predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
  assign first_column_results_size = suggestion_count | plus: editorial_count
  assign product_count = predictive_search.resources.products.size

  comment
    total_results = everything shown in this dropdown, used for layout and the
    screen-reader count.

    page_results_count = what /search?q= can actually return, which is only
    products, pages and articles. Collections are predictive-search-only, and
    query suggestions are pointers to *other* searches rather than results for
    this term. Counting either would make the "view all results" link promise
    results the search page then can't show.
  endcomment
  assign total_results = product_count | plus: first_column_results_size
  assign page_results_count = product_count | plus: editorial_count
  assign storefront_search_terms = predictive_search.terms | append: '*'
-%}
<div id="predictive-search-results" role="listbox">
  {%- if predictive_search.performed -%}
    {%- if total_results > 0 -%}
      <div
        id="predictive-search-results-groups-wrapper"
        class="predictive-search__results-groups-wrapper{% if product_count == 0 %} predictive-search__results-groups-wrapper--no-products{% endif %}{% if suggestion_count == 0 %} predictive-search__results-groups-wrapper--no-suggestions{% endif %}{% if first_column_results_size == 0 %} predictive-search__results-groups-wrapper--no-terms{% endif %}"
      >
        {%- comment -%}
          The left column renders whenever there are results (not only when it has
          terms of its own), so the "view all results" link below always has a
          stable home in this column.
        {%- endcomment -%}
        <div class="predictive-search__result-group">
            {%- if predictive_search.resources.queries.size > 0 -%}
              <div>
                <h2
                  id="predictive-search-queries"
                  class="predictive-search__heading text-body caption-with-letter-spacing"
                >
                  {{- 'templates.search.suggestions' | t -}}
                </h2>
                <ul
                  id="predictive-search-results-queries-list"
                  class="predictive-search__results-list list-unstyled"
                  role="group"
                  aria-labelledby="predictive-search-queries"
                >
                  {%- for query in predictive_search.resources.queries -%}
                    <li
                      id="predictive-search-option-query-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false"
                    >
                      <a
                        href="{{ query.url }}"
                        class="predictive-search__item predictive-search__item--query link link--text"
                        tabindex="-1"
                      >
                        <span class="predictive-search__item-icon svg-wrapper" aria-hidden="true">
                          {{- 'icon-search.svg' | inline_asset_content -}}
                        </span>
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p
                            class="predictive-search__item-heading predictive-search__item-query-result h5"
                            aria-label="{{ query.text }}"
                          >
                            {{ query.styled_text }}
                          </p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if predictive_search.resources.collections.size > 0 -%}
              <div>
                <h2
                  id="predictive-search-collections"
                  class="predictive-search__heading text-body caption-with-letter-spacing"
                >
                  {{- 'templates.search.collections' | t -}}
                </h2>
                <ul
                  id="predictive-search-results-collections-list"
                  class="predictive-search__results-list list-unstyled"
                  role="group"
                  aria-labelledby="predictive-search-collections"
                >
                  {%- for collection in predictive_search.resources.collections -%}
                    <li
                      id="predictive-search-option-collection-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false"
                    >
                      <a
                        href="{{ collection.url }}"
                        class="predictive-search__item{% if collection.featured_image != blank %} predictive-search__item--link-with-thumbnail predictive-search__item--collection{% endif %} link link--text"
                        tabindex="-1"
                      >
                        {%- if collection.featured_image != blank -%}
                          <img
                            class="predictive-search__image predictive-search__image--collection"
                            src="{{ collection.featured_image | image_url: width: 150 }}"
                            alt="{{ collection.featured_image.alt | escape }}"
                            width="50"
                            height="50"
                          >
                        {%- endif -%}
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p class="predictive-search__item-heading h5">{{ collection.title | escape }}</p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- comment -%}
              Pages and articles render once here (upstream rendered them twice and
              hid one copy with CSS); the panel CSS places this group per breakpoint.
            {%- endcomment -%}
            {%- if editorial_count > 0 -%}
              <div class="predictive-search__pages-wrapper">
                <h2 id="predictive-search-pages" class="predictive-search__heading text-body caption-with-letter-spacing">
                  {{- 'templates.search.pages' | t -}}
                </h2>
                <ul
                  id="predictive-search-results-pages-list"
                  class="predictive-search__results-list list-unstyled"
                  role="group"
                  aria-labelledby="predictive-search-pages"
                >
                  {%- for page in predictive_search.resources.pages -%}
                    <li
                      id="predictive-search-option-page-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false"
                    >
                      <a href="{{ page.url }}" class="predictive-search__item link link--text" tabindex="-1">
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p class="predictive-search__item-heading h5">{{ page.title | escape }}</p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                  {%- for article in predictive_search.resources.articles -%}
                    <li
                      id="predictive-search-option-article-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false"
                    >
                      <a href="{{ article.url }}" class="predictive-search__item link link--text" tabindex="-1">
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p class="predictive-search__item-heading h5">{{ article.title | escape }}</p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- comment -%}
              Lives in the left column (not as a full-width footer). Keeps the
              data-predictive-search-search-for-text hook that
              PredictiveSearch.updateSearchForTerm() writes into, and stays a
              role="option" so arrow-key navigation still reaches it.
            {%- endcomment -%}
            <div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button">
              <a
                href="{{ routes.search_url }}?q={{ storefront_search_terms | url_encode }}&amp;type=product%2Cpage%2Carticle&amp;options%5Bunavailable_products%5D=last"
                class="predictive-search__item predictive-search__item--term tg-predictive-search__view-all"
                data-tg-view-all-results
                tabindex="-1"
                role="option"
                aria-selected="false"
              >
                <span data-predictive-search-search-for-text data-tg-view-all-label>
                  {%- if page_results_count > 0 -%}
                    {{- 'templates.search.view_all' | t -}}
                  {%- else -%}
                    {%- comment -%}
                      Only suggestions/collections matched, so /search?q= would come
                      back empty. Don't quote a count we can't honour.
                    {%- endcomment -%}
                    {{- 'templates.search.search_for' | t: terms: predictive_search.terms -}}
                  {%- endif -%}
                </span>
                <span class="svg-wrapper" aria-hidden="true">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </a>
            </div>
          </div>

        {%- if product_count > 0 -%}
          <div class="predictive-search__result-group">
            <div>
              <h2 id="predictive-search-products" class="predictive-search__heading text-body caption-with-letter-spacing">
                {{- 'templates.search.products' | t -}}
              </h2>
              <ul
                id="predictive-search-results-products-list"
                class="predictive-search__results-list predictive-search__results-list--products list-unstyled"
                role="group"
                aria-labelledby="predictive-search-products"
              >
                {%- for product in predictive_search.resources.products -%}
                  <li
                    id="predictive-search-option-product-{{ forloop.index }}"
                    class="predictive-search__list-item"
                    role="option"
                    aria-selected="false"
                  >
                    <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'search' | escape }}">
                      <a
                        href="{{ product.url }}"
                        class="predictive-search__item predictive-search__item--link-with-thumbnail predictive-search__item--product link link--text"
                        tabindex="-1"
                      >
                        {%- if product.featured_media != blank -%}
                          <img
                            class="predictive-search__image predictive-search__image--product"
                            src="{{ product.featured_media | image_url: width: 400 }}"
                            alt="{{ product.featured_media.alt | escape }}"
                            width="200"
                            height="200"
                          >
                        {%- else -%}
                          <span class="predictive-search__image predictive-search__image--product predictive-search__image--placeholder" aria-hidden="true"></span>
                        {%- endif -%}
                        <div class="predictive-search__item-content{% unless settings.predictive_search_show_vendor or settings.predictive_search_show_price %} predictive-search__item-content--centered{% endunless %}">
                          {%- if settings.predictive_search_show_vendor -%}
                            <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
                            <div class="predictive-search__item-vendor caption-with-letter-spacing">
                              {{ product.vendor }}
                            </div>
                          {%- endif -%}
                          <p class="predictive-search__item-heading h5">{{ product.title | escape }}</p>
                          {%- if settings.predictive_search_show_price -%}
                            {% render 'price', product: product, use_variant: true, show_badges: false %}
                          {%- endif -%}
                        </div>
                      </a>
                    </product-component>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="tg-predictive-search__empty" role="status">
        {{ 'templates.search.no_predictive_results' | t: terms: predictive_search.terms }}
      </p>
    {%- endif -%}

    {%- render 'loading-spinner', class: 'predictive-search__loading-state', initially_hidden: true -%}

    {%- comment -%}
      With results, the link sits in the left column above. This fallback only
      covers the no-results case, so shoppers can still reach the full search page.
    {%- endcomment -%}
    {%- if total_results == 0 -%}
      <div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button">
        <a
          href="{{ routes.search_url }}?q={{ storefront_search_terms | url_encode }}&amp;type=product%2Cpage%2Carticle&amp;options%5Bunavailable_products%5D=last"
          class="predictive-search__item predictive-search__item--term tg-predictive-search__view-all"
          tabindex="-1"
          role="option"
          aria-selected="false"
        >
          <span data-predictive-search-search-for-text>
            {{- 'templates.search.search_for' | t: terms: predictive_search.terms -}}
          </span>
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </a>
      </div>
    {%- endif -%}

    <span
      class="hidden"
      data-predictive-search-live-region-count-value
      data-total-results="{{ total_results }}"
    >
      {% liquid
        if total_results == 0
          echo 'templates.search.no_results' | t: terms: predictive_search.terms
        else
          echo 'templates.search.results_with_count' | t: count: total_results | append: ': '
          if suggestion_count > 0
            echo 'templates.search.results_suggestions_with_count' | t: count: suggestion_count | append: ', '
          endif
          if editorial_count > 0
            echo 'templates.search.results_pages_with_count' | t: count: editorial_count | append: ', '
          endif
          if product_count > 0
            echo 'templates.search.results_products_with_count' | t: count: product_count
          endif
        endif
      %}
    </span>
  {%- endif -%}
</div>
