{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tg-sections.js' | asset_url }}" defer="defer"></script>
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-accent: {{ section.settings.button_color }}; --tg-button-text: {{ section.settings.button_text_color }}; --tg-border: {{ section.settings.border_color }}; --tg-video-heading-size: {{ section.settings.heading_font_size }}px; --tg-video-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-video-heading-align: {{ section.settings.heading_alignment }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}><tg-video-rail class="tg-page-width tg-video-rail"><header class="tg-video-rail__header"><div class="tg-video-rail__top">{% if section.settings.heading != blank %}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{% endif %}<div class="tg-rail-controls"><button type="button" data-tg-scroll="-1" aria-label="{{ 'tg.a11y.previous' | t }}">&larr;</button><button type="button" data-tg-scroll="1" aria-label="{{ 'tg.a11y.next' | t }}">&rarr;</button></div></div>{% if section.settings.subheading != blank %}<p class="tg-subheading">{{ section.settings.subheading }}</p>{% endif %}</header><div class="tg-video-rail__track" data-tg-track role="list">{% for block in section.blocks %}{% assign video_source = block.settings.video.sources | where: 'format', 'mp4' | first %}{% assign source_url = video_source.url | default: block.settings.video_url %}<article class="tg-video-card" role="listitem" {{ block.shopify_attributes }}><div class="tg-video-card__media">{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 800 | image_tag: widths: '300, 500, 800', loading: 'lazy', alt: block.settings.description }}{% elsif block.settings.poster_url != blank %}<img src="{{ block.settings.poster_url }}" alt="{{ block.settings.description | escape }}" width="800" height="1422" loading="lazy">{% elsif block.settings.video.preview_image != blank %}{{ block.settings.video.preview_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', loading: 'lazy', alt: block.settings.description }}{% elsif block.settings.product.featured_image != blank %}{{ block.settings.product.featured_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', loading: 'lazy', alt: block.settings.description }}{% else %}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}{% if source_url != blank %}<button class="tg-video-card__play" type="button" data-tg-video="{{ source_url }}" aria-label="{{ 'tg.a11y.play_video' | t }}">&#9658;</button>{% endif %}</div>{% if block.settings.description != blank %}<p class="tg-video-card__text">{{ block.settings.description | escape }}</p>{% endif %}{% if block.settings.button_label != blank %}<a class="tg-button" href="{{ block.settings.link | default: block.settings.product.url | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{% endif %}</article>{% endfor %}</div><dialog class="tg-video-dialog" aria-label="{{ 'tg.a11y.video_dialog' | t }}"><button class="tg-video-dialog__close" type="button" data-tg-close aria-label="{{ 'tg.a11y.close' | t }}">&times;</button><video controls playsinline></video></dialog></tg-video-rail></section>
{% schema %}
