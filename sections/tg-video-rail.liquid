{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tg-sections.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --tg-video-play-button-opacity: {{ section.settings.play_button_opacity | default: 100 | divided_by: 100.0 }};
  }
{%- endstyle -%}
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-accent: {{ section.settings.button_color }}; --tg-button-text: {{ section.settings.button_text_color }}; --tg-border: {{ section.settings.border_color }}; --tg-video-heading-size: {{ section.settings.heading_font_size }}px; --tg-video-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-video-heading-align: {{ section.settings.heading_alignment }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}><tg-video-rail class="tg-page-width tg-video-rail"><header class="tg-video-rail__header"><div class="tg-video-rail__top">{% if section.settings.heading != blank %}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{% endif %}<div class="tg-rail-controls"><button type="button" data-tg-scroll="-1" aria-label="{{ 'tg.a11y.previous' | t }}">&larr;</button><button type="button" data-tg-scroll="1" aria-label="{{ 'tg.a11y.next' | t }}">&rarr;</button></div></div>{% if section.settings.subheading != blank %}<p class="tg-subheading">{{ section.settings.subheading }}</p>{% endif %}</header><div class="tg-video-rail__track" data-tg-track role="list">{% for block in section.blocks %}{% assign video_source = block.settings.video.sources | where: 'format', 'mp4' | first %}{% assign source_url = video_source.url | default: block.settings.video_url %}<article class="tg-video-card" role="listitem" {{ block.shopify_attributes }}><div class="tg-video-card__media">{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 800 | image_tag: widths: '300, 500, 800', loading: 'lazy', alt: block.settings.description }}{% elsif block.settings.poster_url != blank %}<img src="{{ block.settings.poster_url }}" alt="{{ block.settings.description | escape }}" width="800" height="1422" loading="lazy">{% elsif block.settings.video.preview_image != blank %}{{ block.settings.video.preview_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', loading: 'lazy', alt: block.settings.description }}{% elsif block.settings.product.featured_image != blank %}{{ block.settings.product.featured_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', loading: 'lazy', alt: block.settings.description }}{% else %}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}{% if source_url != blank %}<video class="tg-video-card__video" controls playsinline preload="none" data-tg-inline-video data-tg-video-src="{{ source_url | escape }}" aria-label="{{ 'tg.a11y.play_video' | t }}"></video><button class="tg-video-card__play" type="button" data-tg-video-play aria-label="{{ 'tg.a11y.play_video' | t }}">&#9658;</button>{% endif %}</div>{% if block.settings.description != blank %}<p class="tg-video-card__text">{{ block.settings.description | escape }}</p>{% endif %}{% if block.settings.button_label != blank %}<a class="tg-button" href="{{ block.settings.link | default: block.settings.product.url | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{% endif %}</article>{% endfor %}</div></tg-video-rail></section>
{% schema %}
{"name":"t:tg.sections.video_rail.name","tag":"section","class":"section","settings":[{"type":"inline_richtext","id":"heading","label":"t:tg.settings.heading","default":"Featured video"},{"type":"range","id":"heading_font_size","label":"t:tg.settings.heading_font_size","min":18,"max":48,"step":1,"unit":"px","default":30},{"type":"range","id":"heading_font_size_mobile","label":"t:tg.settings.heading_font_size_mobile","min":14,"max":32,"step":1,"unit":"px","default":21},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"text","id":"subheading","label":"t:tg.settings.subheading"},{"type":"color","id":"background","label":"t:tg.settings.background","default":"#ffffff"},{"type":"color","id":"text_color","label":"t:tg.settings.text_color","default":"#18181e"},{"type":"color","id":"button_color","label":"t:tg.settings.button_color","default":"#ffb700"},{"type":"color","id":"button_text_color","label":"t:tg.settings.button_text_color","default":"#ffffff"},{"type":"range","id":"play_button_opacity","label":"Tg | Play button opacity / 播放按钮透明度","min":0,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"border_color","label":"t:tg.settings.border_color","default":"#deded8"},{"type":"range","id":"padding_top","label":"t:tg.settings.padding_top","min":0,"max":140,"step":4,"unit":"px","default":60},{"type":"range","id":"padding_bottom","label":"t:tg.settings.padding_bottom","min":0,"max":140,"step":4,"unit":"px","default":32}],"blocks":[{"type":"video","name":"t:tg.blocks.video.name","settings":[{"type":"video","id":"video","label":"t:tg.settings.video"},{"type":"url","id":"video_url","label":"t:tg.settings.video_url","info":"t:tg.info.video_url"},{"type":"image_picker","id":"poster","label":"t:tg.settings.poster"},{"type":"url","id":"poster_url","label":"Poster image URL"},{"type":"product","id":"product","label":"t:tg.settings.product"},{"type":"textarea","id":"description","label":"t:tg.settings.description"},{"type":"text","id":"button_label","label":"t:tg.settings.button_label","default":"Shop now"},{"type":"url","id":"link","label":"t:tg.settings.link"}]}],"max_blocks":12,"presets": [
  {
    "name": "t:tg.sections.video_rail.name",
    "blocks": [
      {
        "type": "video"
      },
      {
        "type": "video"
      },
      {
        "type": "video"
      },
      {
        "type": "video"
      }
    ]
  }
]}
{% endschema %}
