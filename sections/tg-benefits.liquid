{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section
  class="tg-section tg-benefits"
  style="--tg-background: {{ section.settings.background }}; --tg-muted: {{ section.settings.muted_color }}; --tg-text: {{ section.settings.text_color }}; --tg-accent: {{ section.settings.accent_color }}; --tg-border: {{ section.settings.border_color }}; --tg-columns: {{ section.settings.columns }}; --tg-heading-size: {{ section.settings.heading_font_size }}px; --tg-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-heading-color: {{ section.settings.heading_color }}; --tg-heading-hover-color: {{ section.settings.heading_hover_color }}; --tg-benefit-content-background: {{ section.settings.content_background }}; --tg-benefit-content-padding: {{ section.settings.content_padding }}px; --tg-benefit-content-radius: {{ section.settings.content_radius }}px; --tg-benefit-image-overlap: {{ section.settings.image_overlap }}px; --tg-padding-top: {{ section.settings.padding_top }}px; --tg-padding-bottom: {{ section.settings.padding_bottom }}px; --tg-mobile-padding-top: {{ section.settings.mobile_padding_top }}px; --tg-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px; --tg-benefit-icon-size: {{ section.settings.icon_size }}px; --tg-benefit-icon-size-mobile: {{ section.settings.icon_size_mobile }}px; --tg-heading-weight: {{ section.settings.heading_font_weight }};"
  {{ section.shopify_attributes }}
>
  <div class="tg-page-width">
    <div class="tg-benefits__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="tg-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="tg-benefits__grid">
      {%- for block in section.blocks -%}
        <article
          class="tg-benefit"
          style="--tg-benefit-title-size: {{ block.settings.title_font_size }}px; --tg-benefit-title-size-mobile: {{ block.settings.title_font_size_mobile }}px; --tg-benefit-title-weight: {{ block.settings.title_font_weight }}; --tg-benefit-title-weight-mobile: {{ block.settings.title_font_weight_mobile }}; --tg-benefit-title-color: {{ block.settings.title_color }}; --tg-benefit-title-hover-color: {{ block.settings.title_hover_color }}; --tg-benefit-text-size: {{ block.settings.text_font_size }}px; --tg-benefit-text-size-mobile: {{ block.settings.text_font_size_mobile }}px; --tg-benefit-text-weight: {{ block.settings.text_font_weight }};"
          {{ block.shopify_attributes }}
        >
          <div class="tg-benefit__content">
            <div class="tg-benefit__icon">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 240
                  | image_tag: loading: 'lazy', alt: block.settings.title
                }}
              {% else %}
                {{ 'icon-heart.svg' | inline_asset_content }}
              {% endif %}
            </div>
            <strong class="tg-benefit__title">{{ block.settings.title | escape }}</strong>
            {% if block.settings.text != blank %}
              <span class="tg-benefit__text">{{ block.settings.text | escape }}</span>
            {% endif %}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
