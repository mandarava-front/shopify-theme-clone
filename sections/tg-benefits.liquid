{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section class="tg-section" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-accent: {{ section.settings.accent_color }}; --tg-border: {{ section.settings.border_color }}; --tg-columns: {{ section.settings.columns }}; --tg-heading-size: {{ section.settings.heading_font_size }}px; --tg-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-heading-color: {{ section.settings.heading_color }}; --tg-heading-hover-color: {{ section.settings.heading_hover_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
 <div class="tg-page-width"><div class="tg-benefits__header">{%- if section.settings.heading != blank -%}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{%- endif -%}</div><div class="tg-benefits__grid">{%- for block in section.blocks -%}<article class="tg-benefit" style="--tg-benefit-title-size: {{ block.settings.title_font_size }}px; --tg-benefit-title-size-mobile: {{ block.settings.title_font_size_mobile }}px; --tg-benefit-title-color: {{ block.settings.title_color }}; --tg-benefit-title-hover-color: {{ block.settings.title_hover_color }}; --tg-benefit-text-size: {{ block.settings.text_font_size }}px; --tg-benefit-text-size-mobile: {{ block.settings.text_font_size_mobile }}px;" {{ block.shopify_attributes }}><div class="tg-benefit__icon">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{% else %}{{ 'icon-heart.svg' | inline_asset_content }}{% endif %}</div><strong class="tg-benefit__title">{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %}<span class="tg-benefit__text">{{ block.settings.text | escape }}</span>{% endif %}</article>{%- endfor -%}</div></div>
</section>
