{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section class="tg-section tg-featured-products" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-muted: {{ section.settings.muted_color }}; --tg-accent: {{ section.settings.button_color }}; --tg-button-text: {{ section.settings.button_text_color }}; --tg-price-color: {{ section.settings.price_color }}; --tg-badge-background: {{ section.settings.badge_background }}; --tg-badge-text: {{ section.settings.badge_text_color }}; --tg-star-color: {{ section.settings.star_color }}; --tg-columns: {{ section.settings.columns_desktop }}; --tg-columns-mobile: {{ section.settings.columns_mobile }}; --tg-card-radius: {{ section.settings.card_radius }}px; --tg-padding-top: {{ section.settings.padding_top }}px; --tg-padding-bottom: {{ section.settings.padding_bottom }}px; --tg-mobile-padding-top: {{ section.settings.mobile_padding_top }}px; --tg-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;" {{ section.shopify_attributes }}>
  <div class="tg-page-width">
    <header class="tg-products__header">
      {%- if section.settings.heading != blank -%}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="tg-subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>

    <ul class="tg-product-grid" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks limit: section.settings.products_to_show -%}
          {%- assign tg_block_product = block.settings.product -%}
          {%- if tg_block_product == blank and section.settings.collection != blank -%}
            {%- assign tg_block_product = section.settings.collection.products[forloop.index0] -%}
          {%- endif -%}
          {% render 'tg-featured-product-card', product: tg_block_product, title: block.settings.title, link: block.settings.link, image: block.settings.image, secondary_image: block.settings.secondary_image, badge: block.settings.badge, price: block.settings.price, compare_at_price: block.settings.compare_at_price, reviews: block.settings.reviews, show_badge: section.settings.show_badges, show_rating: section.settings.show_rating, show_secondary_image: section.settings.show_secondary_image, shopify_attributes: block.shopify_attributes %}
        {%- endfor -%}
      {%- elsif section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'tg-featured-product-card', product: product, show_badge: section.settings.show_badges, show_rating: section.settings.show_rating, show_secondary_image: section.settings.show_secondary_image %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
          {%- assign placeholder_image = 'product-apparel-' | append: placeholder_index -%}
          {% render 'tg-featured-product-card', placeholder_image: placeholder_image, show_badge: section.settings.show_badges, show_rating: section.settings.show_rating, show_secondary_image: section.settings.show_secondary_image %}
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- assign view_all_url = section.settings.button_link | default: section.settings.collection.url -%}
    {%- if section.settings.show_view_all and view_all_url != blank -%}
      <div class="tg-products__footer">
        <a class="tg-button" href="{{ view_all_url }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "t:tg.sections.featured_products.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:tg.settings.collection", "info": "t:tg.info.collection_fallback" },
    { "type": "inline_richtext", "id": "heading", "label": "t:tg.settings.heading", "default": "🎁 2026 Trending Now - Customer Favorites" },
    { "type": "text", "id": "subheading", "label": "t:tg.settings.subheading", "default": "Shop our most-loved personalized gifts, perfect for every occasion!" },
    { "type": "range", "id": "products_to_show", "label": "t:tg.settings.products_to_show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "t:tg.settings.desktop_columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "t:tg.settings.mobile_columns", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "show_secondary_image", "label": "t:tg.settings.show_secondary_image", "default": true },
    { "type": "checkbox", "id": "show_badges", "label": "t:tg.settings.show_badges", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "t:tg.settings.show_rating", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "t:tg.settings.show_view_all", "default": true },
    { "type": "text", "id": "button_label", "label": "t:tg.settings.button_label", "default": "VIEW MORE" },
    { "type": "url", "id": "button_link", "label": "t:tg.settings.button_link" },
    { "type": "range", "id": "card_radius", "label": "t:tg.settings.card_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 4 },
    { "type": "color", "id": "background", "label": "t:tg.settings.background", "default": "#f8f8ed" },
    { "type": "color", "id": "text_color", "label": "t:tg.settings.text_color", "default": "#18181e" },
    { "type": "color", "id": "muted_color", "label": "t:tg.settings.muted_color", "default": "#707070" },
    { "type": "color", "id": "price_color", "label": "t:tg.settings.price_color", "default": "#e18a00" },
    { "type": "color", "id": "badge_background", "label": "t:tg.settings.badge_background", "default": "#ffc400" },
    { "type": "color", "id": "badge_text_color", "label": "t:tg.settings.badge_text_color", "default": "#111111" },
    { "type": "color", "id": "star_color", "label": "t:tg.settings.star_color", "default": "#ffb400" },
    { "type": "color", "id": "button_color", "label": "t:tg.settings.button_color", "default": "#ffb700" },
    { "type": "color", "id": "button_text_color", "label": "t:tg.settings.button_text_color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "t:tg.settings.padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "t:tg.settings.padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_padding_top", "label": "t:tg.settings.mobile_padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 38 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "t:tg.settings.mobile_padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:tg.blocks.featured_product.name",
      "settings": [
        { "type": "product", "id": "product", "label": "t:tg.settings.product" },
        { "type": "text", "id": "title", "label": "t:tg.settings.product_title", "info": "t:tg.info.product_title_override" },
        { "type": "url", "id": "link", "label": "t:tg.settings.product_link", "info": "t:tg.info.product_link_override" },
        { "type": "image_picker", "id": "image", "label": "t:tg.settings.product_image" },
        { "type": "image_picker", "id": "secondary_image", "label": "t:tg.settings.secondary_image" },
        { "type": "text", "id": "badge", "label": "t:tg.settings.badge" },
        { "type": "text", "id": "price", "label": "t:tg.settings.price", "info": "t:tg.info.price_override" },
        { "type": "text", "id": "compare_at_price", "label": "t:tg.settings.compare_at_price", "info": "t:tg.info.price_override" },
        { "type": "text", "id": "reviews", "label": "t:tg.settings.reviews" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "t:tg.sections.featured_products.name",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
