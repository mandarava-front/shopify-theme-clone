{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section class="tg-section tg-featured-products" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-muted: {{ section.settings.muted_color }}; --tg-compare: {{ section.settings.compare_color }}; --tg-accent: {{ section.settings.button_color }}; --tg-button-text: {{ section.settings.button_text_color }}; --tg-price-color: {{ section.settings.price_color }}; --tg-badge-background: {{ section.settings.badge_background }}; --tg-badge-text: {{ section.settings.badge_text_color }}; --tg-badge-radius: {{ section.settings.badge_radius | default: 2 }}px; --tg-badge-scale: {{ section.settings.badge_scale | default: 100 | divided_by: 100.0 }}; --tg-badge-scale-mobile: {{ section.settings.badge_scale_mobile | default: 100 | divided_by: 100.0 }}; --tg-star-color: {{ section.settings.star_color }}; --tg-columns: {{ section.settings.columns_desktop }}; --tg-columns-mobile: {{ section.settings.columns_mobile }}; --tg-card-radius-mobile: {{ section.settings.card_radius_mobile }}px; --tg-card-compare-size: {{ section.settings.compare_font_size }}px; --tg-card-compare-size-mobile: {{ section.settings.compare_font_size_mobile }}px; --tg-card-radius: {{ section.settings.card_radius }}px; --tg-padding-top: {{ section.settings.padding_top }}px; --tg-padding-bottom: {{ section.settings.padding_bottom }}px; --tg-mobile-padding-top: {{ section.settings.mobile_padding_top }}px; --tg-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px; --tg-heading-size: {{ section.settings.heading_font_size }}px; --tg-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-heading-weight: {{ section.settings.heading_font_weight }}; --tg-subheading-size: {{ section.settings.subheading_font_size }}px; --tg-subheading-size-mobile: {{ section.settings.subheading_font_size_mobile }}px; --tg-subheading-weight: {{ section.settings.subheading_font_weight }}; --tg-button-font-size: {{ section.settings.button_font_size }}px; --tg-button-font-size-mobile: {{ section.settings.button_font_size_mobile }}px; --tg-button-font-weight: {{ section.settings.button_font_weight }}; --tg-card-title-size: {{ section.settings.title_font_size }}px; --tg-card-title-size-mobile: {{ section.settings.title_font_size_mobile }}px; --tg-card-title-weight: {{ section.settings.title_font_weight }}; --tg-card-price-size: {{ section.settings.price_font_size }}px; --tg-card-price-size-mobile: {{ section.settings.price_font_size_mobile }}px; --tg-card-price-weight: {{ section.settings.price_font_weight }};" {{ section.shopify_attributes }}>
  <div class="tg-page-width">
    <header class="tg-products__header">
      {%- if section.settings.heading != blank -%}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="tg-subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>

    <ul class="tg-product-grid" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks limit: section.settings.products_to_show -%}
          {%- assign tg_block_product = block.settings.product -%}
          {%- if tg_block_product == blank and section.settings.collection != blank -%}
            {%- assign tg_block_product = section.settings.collection.products[forloop.index0] -%}
          {%- endif -%}
          {% render 'tg-featured-product-card', product: tg_block_product, title: block.settings.title, link: block.settings.link, image: block.settings.image, secondary_image: block.settings.secondary_image, badge: block.settings.badge, price: block.settings.price, compare_at_price: block.settings.compare_at_price, reviews: block.settings.reviews, show_badge: section.settings.show_badges, show_rating: section.settings.show_rating, show_secondary_image: section.settings.show_secondary_image, shopify_attributes: block.shopify_attributes %}
        {%- endfor -%}
      {%- elsif section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'tg-featured-product-card', product: product, show_badge: section.settings.show_badges, show_rating: section.settings.show_rating, show_secondary_image: section.settings.show_secondary_image %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
          {%- assign placeholder_image = 'product-apparel-' | append: placeholder_index -%}
          {% render 'tg-featured-product-card', placeholder_image: placeholder_image, show_badge: section.settings.show_badges, show_rating: section.settings.show_rating, show_secondary_image: section.settings.show_secondary_image %}
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- assign view_all_url = section.settings.button_link | default: section.settings.collection.url -%}
    {%- if section.settings.show_view_all and view_all_url != blank -%}
      <div class="tg-products__footer">
        <a class="tg-button" href="{{ view_all_url }}">{{ section.settings.button_label | escape }}<span class="tg-button__arrow" aria-hidden="true">{{ 'tg-home-arrow.svg' | inline_asset_content }}</span></a>
      </div>
    {%- endif -%}
  </div>
</section>
