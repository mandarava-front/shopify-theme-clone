<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if section.settings.enable_tg_header_mobile_menu -%}
  {{- 'component-menu-drawer.css' | asset_url | stylesheet_tag -}}
  {{- 'tg-header-mobile-menu.css' | asset_url | stylesheet_tag -}}
{%- else -%}
  <link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
{%- if section.settings.enable_tg_header_desktop -%}
  {{- 'tg-header-desktop.css' | asset_url | stylesheet_tag -}}
  <script src="{{ 'tg-header-desktop.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif

    assign tg_header_mobile_search_mode = section.settings.tg_header_mobile_search_mode | default: 'row'
    assign tg_header_mobile_search_override = blank

    if request.page_type == 'index'
      assign tg_header_mobile_search_override = section.settings.tg_header_mobile_home_search_mode
    elsif request.page_type == 'product'
      assign tg_header_mobile_search_override = section.settings.tg_header_mobile_product_search_mode
    endif

    if tg_header_mobile_search_override == 'row' or tg_header_mobile_search_override == 'icon'
      assign tg_header_mobile_search_mode = tg_header_mobile_search_override
    endif
  -%}
  {%- if section.settings.enable_tg_header_desktop -%}
    {%- liquid
    assign tg_header_desktop_utility_count = 0
    assign tg_header_desktop_navigation_count = 0
    for block in section.blocks
      if block.type == 'tg_header_desktop_utility'
        assign tg_header_desktop_utility_count = tg_header_desktop_utility_count | plus: 1
      endif
      if block.type == 'tg_pc_nav_item' and block.settings.title != blank
        assign tg_header_desktop_navigation_count = tg_header_desktop_navigation_count | plus: 1
      endif
    endfor
    -%}
    <tg-header-desktop
      class="tg-header-desktop"
      data-announcement-key="tg-desktop-announcement-{{ section.id }}"
      data-announcement-dismissible="{{ section.settings.tg_header_desktop_announcement_dismissible }}"
      style="
        --tg-header-desktop-announcement-background: {{ section.settings.tg_header_desktop_announcement_background }};
        --tg-header-desktop-announcement-text: {{ section.settings.tg_header_desktop_announcement_text }};
        --tg-header-desktop-background: {{ section.settings.tg_header_desktop_background }};
        --tg-header-desktop-text: {{ section.settings.tg_header_desktop_text }};
        --tg-header-desktop-hover: {{ section.settings.tg_header_desktop_hover }};
        --tg-header-desktop-border: {{ section.settings.tg_header_desktop_border }};
        --tg-header-desktop-badge-background: {{ section.settings.tg_header_desktop_badge_background }};
        --tg-header-desktop-badge-text: {{ section.settings.tg_header_desktop_badge_text }};
        --tg-header-desktop-max-width: {{ section.settings.tg_header_desktop_max_width }}px;
        --tg-header-desktop-logo-width: {{ section.settings.tg_header_desktop_logo_width }}px;
        --tg-header-desktop-nav-height: {{ section.settings.tg_header_desktop_nav_height }}px;
        --tg-header-desktop-nav-gap: {{ section.settings.tg_header_desktop_menu_gap }}px;
        --tg-header-desktop-border-width: {{ section.settings.tg_header_desktop_menu_border_width }}px;
        --tg-header-desktop-panel-width: {{ section.settings.tg_header_desktop_menu_panel_width }}%;
        --tg-header-desktop-panel-columns: {{ section.settings.tg_header_desktop_menu_panel_columns }};
      "
    >
      {%- if section.settings.tg_header_desktop_show_announcement -%}
        <div class="tg-header-desktop__announcement" data-tg-announcement>
          <div class="tg-header-desktop__announcement-inner">
            <p>{{ section.settings.tg_header_desktop_announcement_text_content | escape }}</p>
            {%- if section.settings.tg_header_desktop_announcement_dismissible -%}
              <button
                class="tg-header-desktop__announcement-close focus-inset"
                type="button"
                data-tg-announcement-close
                aria-label="{{ section.settings.tg_header_desktop_announcement_close_label | escape }}"
              >
                <span class="svg-wrapper" aria-hidden="true">{{- 'icon-close.svg' | inline_asset_content -}}</span>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <nav class="tg-header-desktop__nav" aria-label="{{ 'sections.header.tg_header_desktop.navigation_label' | t }}">
        <div class="tg-header-desktop__top">
          <div class="tg-header-desktop__inner tg-header-desktop__top-inner">
          <a href="{{ routes.root_url }}" class="tg-header-desktop__logo focus-inset" aria-label="{{ shop.name | escape }}">
            {%- if section.settings.tg_header_desktop_logo != blank -%}
              {{
                section.settings.tg_header_desktop_logo
                | image_url: width: 480
                | image_tag:
                  widths: '120, 180, 240, 360, 480',
                  sizes: 'var(--tg-header-desktop-logo-width)',
                  preload: true,
                  alt: section.settings.tg_header_desktop_logo.alt | default: shop.name
              }}
            {%- elsif settings.logo != blank -%}
              {{
                settings.logo
                | image_url: width: 480
                | image_tag:
                  widths: '120, 180, 240, 360, 480',
                  sizes: 'var(--tg-header-desktop-logo-width)',
                  preload: true,
                  alt: settings.logo.alt | default: shop.name
              }}
            {%- else -%}
              <span>{{ section.settings.tg_header_desktop_logo_text | escape }}</span>
            {%- endif -%}
          </a>

          {%- if section.settings.tg_header_desktop_show_search -%}
            <form class="tg-header-desktop__search" action="{{ routes.search_url }}" method="get" role="search">
                <label class="visually-hidden" for="TgHeaderDesktopSearch-{{ section.id }}">{{ section.settings.tg_header_desktop_search_label | escape }}</label>
                <input id="TgHeaderDesktopSearch-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.tg_header_desktop_search_placeholder | escape }}" data-tg-search-input>
                <input type="hidden" name="options[prefix]" value="last">
                <button type="submit" class="tg-header-desktop__search-submit focus-inset" aria-label="{{ section.settings.tg_header_desktop_search_label | escape }}"><span class="svg-wrapper" aria-hidden="true">{{- 'icon-search.svg' | inline_asset_content -}}</span></button>
            </form>
          {%- endif -%}

          <div class="tg-header-desktop__top-actions">
            {%- if section.settings.tg_header_desktop_show_utility_links -%}
              <div class="tg-header-desktop__utilities">
                {%- if tg_header_desktop_utility_count > 0 -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'tg_header_desktop_utility' and block.settings.link != blank -%}
                      {%- assign desktop_utility_icon = block.settings.icon_asset | default: 'gift' -%}
                      <a href="{{ block.settings.link }}" class="tg-header-desktop__utility focus-inset" {{ block.shopify_attributes }}>
                        <span class="svg-wrapper" aria-hidden="true">{{- desktop_utility_icon | prepend: 'tg-icon-' | append: '.svg' | inline_asset_content -}}</span>
                        <span>{{ block.settings.title | escape }}</span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'mobile_utility_link' and block.settings.link != blank -%}
                      {%- liquid
                        assign desktop_utility_title = block.settings.title | downcase
                        assign desktop_utility_icon = 'gift'
                        if desktop_utility_title contains 'track'
                          assign desktop_utility_icon = 'track-order'
                        elsif desktop_utility_title contains 'review'
                          assign desktop_utility_icon = 'reviews'
                        endif
                      -%}
                      <a href="{{ block.settings.link }}" class="tg-header-desktop__utility focus-inset">
                        <span class="svg-wrapper" aria-hidden="true">{{- desktop_utility_icon | prepend: 'tg-icon-' | append: '.svg' | inline_asset_content -}}</span>
                        <span>{{ block.settings.title | escape }}</span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.tg_header_desktop_show_social_links -%}
              <div class="tg-header-desktop__social" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tg_header_desktop_social' and block.settings.link != blank -%}
                    {%- assign desktop_social_icon = block.settings.platform | default: 'instagram' -%}
                    <a
                      href="{{ block.settings.link }}"
                      class="tg-header-desktop__social-link focus-inset"
                      aria-label="{{ block.settings.accessibility_label | default: desktop_social_icon | escape }}"
                      role="listitem"
                      target="_blank"
                      rel="me noopener noreferrer"
                      {{ block.shopify_attributes }}
                    >
                      <span class="svg-wrapper" aria-hidden="true">{{- desktop_social_icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}</span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if section.settings.tg_header_desktop_show_cart -%}
              <a href="{{ routes.cart_url }}" class="tg-header-desktop__action tg-header-desktop__cart focus-inset" aria-label="{{ section.settings.tg_header_desktop_cart_label | escape }}">
                <span class="svg-wrapper" aria-hidden="true">{{- 'icon-cart.svg' | inline_asset_content -}}</span>
                <span class="tg-header-desktop__cart-count" aria-hidden="true" data-tg-cart-count>{% if cart.item_count < 100 %}{{ cart.item_count }}{% endif %}</span>
                <span class="visually-hidden" data-tg-cart-count-label>{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </a>
            {%- endif -%}
          </div>
          </div>
        </div>

        {%- if tg_header_desktop_navigation_count > 0 -%}
          <div class="tg-header-desktop__menu-row">
            <div class="tg-header-desktop__inner">
              <div class="tg-header-desktop__menu-links tg-header-desktop__menu-links--{{ section.settings.tg_header_desktop_menu_alignment | default: 'center' }}" role="list">
                {%- for nav_item in section.blocks -%}
                  {%- if nav_item.type == 'tg_pc_nav_item' and nav_item.settings.title != blank -%}
                    {%- liquid
                      assign has_desktop_submenu = false
                      if nav_item.settings.enable_dropdown
                        assign is_current_desktop_nav = false
                        assign has_current_desktop_group = false
                        for nav_content_item in section.blocks
                          if nav_content_item.id == nav_item.id
                            assign is_current_desktop_nav = true
                          elsif is_current_desktop_nav
                            if nav_content_item.type == 'tg_pc_nav_item'
                              break
                            elsif nav_content_item.type == 'tg_pc_nav_group' and nav_content_item.settings.title != blank
                              assign has_current_desktop_group = true
                            elsif nav_content_item.type == 'tg_pc_nav_link' and has_current_desktop_group and nav_content_item.settings.title != blank and nav_content_item.settings.link != blank
                              assign has_desktop_submenu = true
                              break
                            endif
                          endif
                        endfor
                      endif
                    -%}

                    {%- if has_desktop_submenu -%}
                      {%- assign desktop_panel_id = 'TgDesktopHeaderPanel-' | append: section.id | append: '-' | append: nav_item.id -%}
                      <header-menu class="tg-header-desktop__menu-disclosure" {{ nav_item.shopify_attributes }}>
                        <details id="TgDesktopHeaderMenu-{{ section.id }}-{{ nav_item.id }}">
                          <summary
                            class="tg-header-desktop__menu-link focus-inset"
                            aria-controls="{{ desktop_panel_id }}"
                            aria-haspopup="true"
                            style="--tg-header-desktop-nav-item-color: {{ nav_item.settings.text_color }}; --tg-header-desktop-nav-item-weight: {{ nav_item.settings.font_weight }}; --tg-header-desktop-nav-item-size: {{ nav_item.settings.font_size }}px;"
                          >
                            {{ nav_item.settings.title | escape }}
                          </summary>
                          <div id="{{ desktop_panel_id }}" class="tg-header-desktop__menu-panel" aria-label="{{ nav_item.settings.title | escape }}">
                            <div class="tg-header-desktop__menu-panel-grid" role="list">
                              {%- assign is_current_desktop_nav = false -%}
                              {%- for nav_content_item in section.blocks -%}
                                {%- if nav_content_item.id == nav_item.id -%}
                                  {%- assign is_current_desktop_nav = true -%}
                                {%- elsif is_current_desktop_nav -%}
                                  {%- if nav_content_item.type == 'tg_pc_nav_item' -%}
                                    {%- break -%}
                                  {%- elsif nav_content_item.type == 'tg_pc_nav_group' and nav_content_item.settings.title != blank -%}
                                    <div
                                      class="tg-header-desktop__menu-panel-column"
                                      role="listitem"
                                      style="--tg-header-desktop-group-color: {{ nav_content_item.settings.text_color }}; --tg-header-desktop-group-weight: {{ nav_content_item.settings.font_weight }}; --tg-header-desktop-group-size: {{ nav_content_item.settings.font_size }}px;"
                                      {{ nav_content_item.shopify_attributes }}
                                    >
                                      <span class="tg-header-desktop__menu-panel-title">{{ nav_content_item.settings.title | escape }}</span>
                                      <ul class="tg-header-desktop__menu-panel-list" role="list">
                                        {%- assign is_current_desktop_group = false -%}
                                        {%- for nav_group_link in section.blocks -%}
                                          {%- if nav_group_link.id == nav_content_item.id -%}
                                            {%- assign is_current_desktop_group = true -%}
                                          {%- elsif is_current_desktop_group -%}
                                            {%- if nav_group_link.type == 'tg_pc_nav_item' or nav_group_link.type == 'tg_pc_nav_group' -%}
                                              {%- break -%}
                                            {%- elsif nav_group_link.type == 'tg_pc_nav_link' and nav_group_link.settings.title != blank and nav_group_link.settings.link != blank -%}
                                              <li {{ nav_group_link.shopify_attributes }}>
                                                <a
                                                  href="{{ nav_group_link.settings.link }}"
                                                  class="tg-header-desktop__menu-panel-link focus-inset"
                                                  style="--tg-header-desktop-menu-link-color: {{ nav_group_link.settings.text_color }}; --tg-header-desktop-menu-link-weight: {{ nav_group_link.settings.font_weight }}; --tg-header-desktop-menu-link-size: {{ nav_group_link.settings.font_size }}px;"
                                                >
                                                  {{ nav_group_link.settings.title | escape }}
                                                </a>
                                              </li>
                                            {%- endif -%}
                                          {%- endif -%}
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endfor -%}
                            </div>
                          </div>
                        </details>
                      </header-menu>
                    {%- elsif nav_item.settings.link != blank -%}
                      <a
                        href="{{ nav_item.settings.link }}"
                        class="tg-header-desktop__menu-link focus-inset"
                        style="--tg-header-desktop-nav-item-color: {{ nav_item.settings.text_color }}; --tg-header-desktop-nav-item-weight: {{ nav_item.settings.font_weight }}; --tg-header-desktop-nav-item-size: {{ nav_item.settings.font_size }}px;"
                        {{ nav_item.shopify_attributes }}
                      >
                        {{ nav_item.settings.title | escape }}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </nav>
    </tg-header-desktop>
  {%- endif -%}
  <header
    class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}{% if section.settings.enable_tg_header_mobile_menu %} header--tg-mobile-menu-enabled header--tg-mobile-search-{{ tg_header_mobile_search_mode }}{% endif %}{% if section.settings.enable_tg_header_desktop %} header--tg-desktop-enabled{% endif %}"
    {% if section.settings.enable_tg_header_mobile_menu %}
      style="
        --tg-header-mobile-search-font-size: {{ section.settings.tg_header_mobile_search_font_size | default: 14 }}px;
        --tg-header-mobile-search-placeholder-color: {{ section.settings.tg_header_mobile_search_placeholder_color | default: '#737379' }};
        --tg-header-mobile-search-top-spacing: {{ section.settings.tg_header_mobile_search_top_spacing | default: 6 }}px;
        --tg-header-mobile-search-bottom-spacing: {{ section.settings.tg_header_mobile_search_bottom_spacing | default: 12 }}px;
      "
    {% endif %}
  >
    {%- liquid
      if section.settings.enable_tg_header_mobile_menu
        render 'tg-header-mobile-menu'
      endif

      if section.settings.menu != blank
        if section.settings.enable_tg_header_mobile_menu == false
          render 'header-drawer'
        elsif section.settings.menu_type_desktop == 'drawer'
          render 'header-drawer', desktop_only: true
        endif
      endif

      if section.settings.logo_position == 'top-center' or section.settings.menu == blank
        render 'header-search', input_id: 'Search-In-Modal-1'
      endif
    -%}

    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo motion-reduce',
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      if section.settings.menu != blank
        if section.settings.menu_type_desktop == 'dropdown'
          render 'header-dropdown-menu'
        elsif section.settings.menu_type_desktop != 'drawer'
          render 'header-mega-menu'
        endif
      endif
    %}

    {%- if section.settings.logo_position == 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(min-width: 750px) {{ settings.logo_width }}px, 50vw{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo',
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {% render 'header-search-inline', input_id: 'Search-In-Header' %}

    {%- if section.settings.enable_tg_header_mobile_menu and tg_header_mobile_search_mode == 'row' -%}
      {%- assign tg_header_mobile_search_input_id = 'TgMobileHeaderSearch-' | append: section.id -%}
      {% render 'tg-header-mobile-search', input_id: tg_header_mobile_search_input_id, placeholder: section.settings.tg_header_mobile_search_placeholder %}
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="cuszoo-header-links small-hide medium-hide">
        <a href="{{ routes.account_url }}" class="cuszoo-header-link">
          Sign In
        </a>
        <a href="{{ routes.account_url }}" class="cuszoo-header-link">
          Track Order
        </a>
        <a href="/pages/wishlist" class="cuszoo-header-link cuszoo-header-link--icon" aria-label="Wishlist">
          <span class="svg-wrapper">{{- 'icon-heart.svg' | inline_asset_content -}}</span>
        </a>
      </div>
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      {% render 'header-search', input_id: 'Search-In-Modal' %}

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
