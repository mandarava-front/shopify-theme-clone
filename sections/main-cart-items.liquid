{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{%- if settings.tg_teeinblue_hide_plugin_cart_preview != false -%}
  <style>
    /* TeeInBlue compatibility: retain the theme's cart Preview button and
       hide the plugin's duplicate trigger on cart pages. */
    body:has(main[data-template='cart']) .tee-preview-button__wrapper {
      display: none !important;
    }
  </style>
{%- endif -%}

<script>
  (() => {
    const cartTemplate = document.querySelector('main[data-template="cart"]');
    if (!cartTemplate) return;

    const syncPreviewImage = (cartItem) => {
      const themePreview = cartItem.querySelector('[data-tg-cart-preview]');
      const pluginImage = cartItem.querySelector('.tee-cart-thumbnail__img[src]');
      if (!themePreview || !pluginImage) return;

      const imageUrl = pluginImage.currentSrc || pluginImage.src;
      if (!imageUrl) return;

      themePreview.dataset.tgCartPreviewImage = imageUrl;
      themePreview.dataset.tgCartPreviewFallback = imageUrl;
      themePreview.dataset.tgCartPreviewAlt = pluginImage.alt || themePreview.dataset.tgCartPreviewAlt || '';
    };

    const syncAllPreviewImages = () => {
      document.querySelectorAll('.cart-item').forEach(syncPreviewImage);
    };

    if (window.TgTeeInBlueCartPreviewObserver) {
      window.TgTeeInBlueCartPreviewObserver.disconnect();
    }

    /* TeeInBlue inserts its rendered cart thumbnail asynchronously. Sync the
       native Preview button when that image is added or its source changes. */
    const observer = new MutationObserver(syncAllPreviewImages);
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class', 'href', 'src'],
    });
    window.TgTeeInBlueCartPreviewObserver = observer;

    document.addEventListener(
      'click',
      (event) => {
        if (!(event.target instanceof Element)) return;

        const themePreview = event.target.closest('[data-tg-cart-preview]');
        const cartItem = themePreview?.closest('.cart-item');
        if (cartItem) syncPreviewImage(cartItem);
      },
      true,
    );

    syncAllPreviewImages();
  })();
</script>

<cart-items
  class="gradient color-{{ section.settings.color_scheme }} isolate{% if section.settings.enable_tg_cart_page_style %} tg-cart-page{% endif %}{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}"
  {% if section.settings.enable_tg_cart_page_style %}style="--tg-cart-accent: {{ section.settings.tg_cart_page_accent_color }}; --tg-cart-surface: {{ section.settings.tg_cart_page_surface_color }}; --tg-cart-card: {{ section.settings.tg_cart_page_card_color }}; --tg-cart-border: {{ section.settings.tg_cart_page_border_color }}; --tg-cart-text: {{ section.settings.tg_cart_page_text_color }}; --tg-cart-muted: {{ section.settings.tg_cart_page_muted_color }}; --tg-cart-radius: {{ section.settings.tg_cart_card_radius }}px; --tg-cart-font: {{ section.settings.tg_cart_font.family }}, {{ section.settings.tg_cart_font.fallback_families }}; --tg-cart-empty-button-background: {{ section.settings.empty_button_background_color }}; --tg-cart-empty-button-hover-background: {{ section.settings.empty_button_hover_background_color }}; --tg-cart-empty-button-text: {{ section.settings.empty_button_text_color }}; --tg-cart-empty-button-border: {{ section.settings.empty_button_border_color }}; --tg-cart-empty-button-border-width: {{ section.settings.empty_button_border_width }}px; --tg-cart-empty-button-radius: {{ section.settings.empty_button_radius }}px; --tg-cart-empty-button-height: {{ section.settings.empty_button_height }}px; --tg-cart-empty-button-font-size: {{ section.settings.empty_button_font_size }}px;"{% endif %}
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="page-width">
    {% if section.settings.enable_tg_cart_page_style %}
      {% render 'tg-cart-expiry-notice', section: section, cart: cart %}
    {% endif %}
    {% if section.settings.enable_tg_cart_page_style and section.settings.tg_cart_show_announcement and section.settings.announcement_text != blank %}
      <div class="tg-cart-page__announcement" role="status">
        {{ section.settings.announcement_text | escape }}
      </div>
    {% endif %}
    <div class="title-wrapper-with-link tg-cart-page__header">
      <h1 class="title title--primary">
        {% if section.settings.enable_tg_cart_page_style and section.settings.tg_cart_title != blank %}
          {{ section.settings.tg_cart_title | escape }}
        {% else %}
          {{ 'sections.cart.title' | t }}
        {% endif %}
        {% if section.settings.enable_tg_cart_page_style and section.settings.tg_cart_show_item_count %}
          <span class="tg-cart-page__count">({{ cart.item_count }})</span>
        {% endif %}
      </h1>
      <a
        href="{% if section.settings.enable_tg_cart_page_style and section.settings.tg_cart_continue_link != blank %}{{ section.settings.tg_cart_continue_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        class="underlined-link tg-cart-page__continue"
      >
        <span class="tg-cart-inline-icon" aria-hidden="true">{{- 'icon-discount.svg' | inline_asset_content -}}</span>
        {% if section.settings.enable_tg_cart_page_style and section.settings.tg_cart_continue_label != blank %}
          {{ section.settings.tg_cart_continue_label | escape }}
        {% else %}
          {{ 'general.continue_shopping' | t }}
        {% endif %}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">
        {% if section.settings.enable_tg_cart_page_style and section.settings.empty_heading != blank %}
          {{ section.settings.empty_heading | escape }}
        {% else %}
          {{ 'sections.cart.empty' | t }}
        {% endif %}
      </h1>
      {% if section.settings.enable_tg_cart_page_style and section.settings.empty_text != blank %}
        <p class="tg-cart-page__empty-text">{{ section.settings.empty_text | escape }}</p>
      {% endif %}
      <a
        href="{% if section.settings.empty_button_link != blank %}{{ section.settings.empty_button_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        class="button tg-cart-page__empty-button"
      >
        {% if section.settings.empty_button_label != blank %}
          {{ section.settings.empty_button_label | escape }}
        {% else %}
          {{ 'general.continue_shopping' | t }}
        {% endif %}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents tg-cart-page__form critical-hidden" method="post" id="cart">
      <div class="cart__items tg-cart-items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <div class="cart-items tg-cart-items__list" role="list">
              {%- for item in cart.items -%}
                <div
                    class="cart-item tg-cart-item {% if item.parent_relationship.parent != null %}cart-item__nested-line{% endif %}"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    role="listitem"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                  >
                    <div class="cart-item__media tg-cart-item__media">
                      {%- liquid
                        assign tg_cart_customized_thumb = item.properties['_customily-thumb']
                        assign tg_cart_customized_preview = item.properties['_customily-preview']
                        assign tg_cart_teeinblue_customization_id = item.properties['_customization_id']
                        assign tg_cart_item_image = item.image
                        assign tg_cart_item_image_url = blank
                        assign tg_cart_item_image_alt = item.product.title
                        assign tg_cart_item_image_is_customized = false

                        if tg_cart_customized_thumb != blank
                          assign tg_cart_item_image_url = tg_cart_customized_thumb
                          assign tg_cart_item_image_is_customized = true
                        else
                          if tg_cart_item_image == blank
                            assign tg_cart_item_image = item.variant.image
                          endif
                          if tg_cart_item_image == blank
                            assign tg_cart_item_image = item.product.featured_image
                          endif
                          if tg_cart_item_image != blank
                            assign tg_cart_item_image_url = tg_cart_item_image | image_url: width: 600
                            assign tg_cart_item_image_alt = tg_cart_item_image.alt | default: item.product.title
                          endif
                        endif

                        assign tg_cart_preview_image = tg_cart_customized_preview | default: tg_cart_item_image_url
                        assign tg_cart_preview_fallback_image = tg_cart_item_image_url
                        if tg_cart_item_image_is_customized
                          assign tg_cart_preview_fallback_image = item.image | image_url: width: 1600
                        endif
                      -%}
                      {% comment %} Keep a space inside the link because Dawn hides empty anchors. {% endcomment %}
                      <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                      <div class="cart-item__image-container tg-cart-item__image-container">
                        {%- if tg_cart_item_image_url != blank -%}
                          <img
                            src="{{ tg_cart_item_image_url }}"
                            {% unless tg_cart_item_image_is_customized %}
                              srcset="{{ tg_cart_item_image | image_url: width: 180 }} 180w, {{ tg_cart_item_image | image_url: width: 360 }} 360w, {{ tg_cart_item_image | image_url: width: 600 }} 600w"
                            {% endunless %}
                            sizes="(min-width: 990px) 168px, 104px"
                            class="cart-item__image"
                            alt="{{ tg_cart_item_image_alt | escape }}"
                            {% if tg_cart_item_image_is_customized and tg_cart_preview_fallback_image != blank %}
                              data-tg-cart-image-fallback="{{ tg_cart_preview_fallback_image }}"
                            {% endif %}
                            {% if forloop.first %}
                              loading="eager"
                              fetchpriority="high"
                            {% else %}
                              loading="lazy"
                            {% endif %}
                            width="300"
                            height="{% if tg_cart_item_image_is_customized %}300{% else %}{{ 300 | divided_by: tg_cart_item_image.aspect_ratio | ceil }}{% endif %}"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'tg-cart-item__placeholder placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      {%- if section.settings.tg_cart_show_preview and tg_cart_preview_image != blank -%}
                        <button
                          class="tg-cart-item__preview button button--tertiary"
                          type="button"
                          data-tg-cart-preview
                          data-tg-cart-preview-image="{{ tg_cart_preview_image }}"
                          data-tg-cart-preview-fallback="{{ tg_cart_preview_fallback_image }}"
                          data-tg-cart-preview-alt="{{ tg_cart_item_image_alt | escape }}"
                          aria-label="{{ section.settings.tg_cart_preview_label | default: 'Preview image' | escape }}: {{ item.product.title | escape }}"
                        >
                          <span class="tg-cart-inline-icon" aria-hidden="true">{{- 'tg-icon-preview.svg' | inline_asset_content -}}</span>
                          {{ section.settings.tg_cart_preview_label | default: 'Preview' | escape }}
                        </button>
                      {%- endif -%}
                    </div>

                    <div class="cart-item-content tg-cart-item-content">
                    <div class="cart-item__details tg-cart-item__details">
                      {%- if settings.show_vendor and section.settings.tg_cart_show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <div class="cart-item__title tg-cart-item__title">
                        <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>
                        {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-cart-' | append: item.key | replace: ':', '-' -%}
                        {%- render 'cart-disclosure-indicator',
                          product: item.product,
                          modal_id: cart_disclosure_modal_id
                        -%}
                      </div>

                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices tg-cart-item__unit-price">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s class="cart-item__old-price product-option">
                            {{- item.original_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong class="cart-item__final-price product-option">
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {%- else -%}
                        <div class="product-option tg-cart-item__unit-price">
                          {{ item.original_price | money }}
                        </div>
                      {%- endif -%}

                      {%- if section.settings.tg_cart_show_options -%}
                        {%- assign cart_item_options_modal_id = 'CartItemOptionsModal-page-' | append: item.key | replace: ':', '-' -%}
                        {%- capture cart_item_options_modal_style -%}
                          --cart-item-options-accent: {{ section.settings.tg_cart_page_accent_color }};
                          --cart-item-options-surface: {{ section.settings.tg_cart_page_card_color }};
                          --cart-item-options-border: {{ section.settings.tg_cart_page_border_color }};
                          --cart-item-options-text: {{ section.settings.tg_cart_page_text_color }};
                          --cart-item-options-muted: {{ section.settings.tg_cart_page_muted_color }};
                          --cart-item-options-radius: {{ section.settings.tg_cart_card_radius }}px;
                        {%- endcapture -%}
                        {%- render 'cart-item-options',
                          item: item,
                          modal_id: cart_item_options_modal_id,
                          inline_class: 'tg-cart-item__options',
                          surface: 'page',
                          modal_style: cart_item_options_modal_style
                        -%}
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>

                      {%- if tg_cart_teeinblue_customization_id != blank -%}
                        {%- comment -%}
                          TeeInBlue uses this documented marker to render its
                          preview trigger and fetch the rendered customization.
                        {%- endcomment -%}
                        <div
                          class="tee-preview-design tg-teeinblue-cart-preview-source"
                          data-customization-id="{{ tg_cart_teeinblue_customization_id | escape }}"
                        ></div>
                      {%- endif -%}
                    </div>
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif

                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <div class="product-controls-group tg-cart-item__controls">
                    <div class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                aria-expanded="false"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                              >
                                {{- 'icon-info.svg' | inline_asset_content -}}
                              </button>
                            {%- endif -%}
                            <quantity-input class="quantity cart-quantity">
                              {% assign can_update_quantity = item.instructions.can_update_quantity | default: true %}
                              <button
                                class="quantity__button"
                                name="minus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-minus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                data-quantity-line-key="{{ item.key }}"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                              <button
                                class="quantity__button"
                                name="plus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-plus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                            {% assign can_remove = item.instructions.can_remove | default: true %}
                            {% if can_remove == false %}
                              class="hidden"
                            {% endif %}
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-remove.svg' | inline_asset_content -}}
                              </span>
                            </a>
                          </cart-remove-button>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                            aria-expanded="false"
                          >
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- elsif has_qty_rules -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        {%- endif -%}
                        {%- if has_vol_pricing or has_qty_rules -%}
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.multiples_of'
                                    | t: quantity: item.variant.quantity_rule.increment
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.min_of'
                                    | t: quantity: item.variant.quantity_rule.min
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.max_of'
                                    | t: quantity: item.variant.quantity_rule.max
                                  -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary large-up-hide"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    {%- assign price = item.variant.price | money_with_currency -%}
                                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      {%- assign price = price_break.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </div>

                    <div class="cart-item__totals right tg-cart-item__totals">
                      {%- render 'loading-spinner', initially_hidden: true -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

