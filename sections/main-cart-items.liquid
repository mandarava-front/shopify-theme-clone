{% if section.settings.enable_tg_cart_page_style %}
  {%- assign tg_cart_font_bold = section.settings.tg_cart_font | font_modify: 'weight', '700' -%}
  {% style %}
    {{ section.settings.tg_cart_font | font_face: font_display: 'swap' }}
    {{ tg_cart_font_bold | font_face: font_display: 'swap' }}
  {% endstyle %}
  {{ 'tg-cart-page.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tg-cart-page.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

