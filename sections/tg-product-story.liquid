{{ 'tg-product-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="tg-product-story section-{{ section.id }}-padding" style="--tg-product-story-accent: {{ section.settings.accent_color }}; --tg-product-story-text: {{ section.settings.text_color }}; --tg-product-story-surface: {{ section.settings.surface_color }}; --tg-product-story-heading-size: {{ section.settings.heading_font_size }}px; --tg-product-story-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-product-story-heading-weight: {{ section.settings.heading_font_weight }}; --tg-product-story-subheading-size: {{ section.settings.subheading_font_size }}px; --tg-product-story-subheading-size-mobile: {{ section.settings.subheading_font_size_mobile }}px; --tg-product-story-subheading-weight: {{ section.settings.subheading_font_weight }};">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="tg-product-story__header">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<div class="rte">{{ section.settings.subheading }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="tg-product-story__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'hero' -%}
            <article class="tg-product-story__hero" style="--tg-ps-heading-size: {{ block.settings.heading_font_size }}px; --tg-ps-heading-size-mobile: {{ block.settings.heading_font_size_mobile }}px; --tg-ps-heading-weight: {{ block.settings.heading_font_weight }}; --tg-ps-text-size: {{ block.settings.text_font_size }}px; --tg-ps-text-size-mobile: {{ block.settings.text_font_size_mobile }}px; --tg-ps-text-weight: {{ block.settings.text_font_weight }}; --tg-ps-button-size: {{ block.settings.button_font_size }}px; --tg-ps-button-size-mobile: {{ block.settings.button_font_size_mobile }}px; --tg-ps-button-weight: {{ block.settings.button_font_weight }};" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1800, 2400', sizes: '(min-width: 990px) 1260px, calc(100vw - 40px)', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}
              {%- endif -%}
              <div>
                {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}<a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
              </div>
            </article>
          {%- when 'benefit' -%}
            <article class="tg-product-story__benefit" style="--tg-ps-heading-size: {{ block.settings.heading_font_size }}px; --tg-ps-heading-size-mobile: {{ block.settings.heading_font_size_mobile }}px; --tg-ps-heading-weight: {{ block.settings.heading_font_weight }}; --tg-ps-text-size: {{ block.settings.text_font_size }}px; --tg-ps-text-size-mobile: {{ block.settings.text_font_size_mobile }}px; --tg-ps-text-weight: {{ block.settings.text_font_weight }};" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, calc(100vw - 40px)', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}{%- endif -%}
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            </article>
          {%- when 'detail' -%}
            <article class="tg-product-story__detail" style="--tg-ps-eyebrow-size: {{ block.settings.eyebrow_font_size }}px; --tg-ps-eyebrow-size-mobile: {{ block.settings.eyebrow_font_size_mobile }}px; --tg-ps-eyebrow-weight: {{ block.settings.eyebrow_font_weight }}; --tg-ps-heading-size: {{ block.settings.heading_font_size }}px; --tg-ps-heading-size-mobile: {{ block.settings.heading_font_size_mobile }}px; --tg-ps-heading-weight: {{ block.settings.heading_font_weight }}; --tg-ps-text-size: {{ block.settings.text_font_size }}px; --tg-ps-text-size-mobile: {{ block.settings.text_font_size_mobile }}px; --tg-ps-text-weight: {{ block.settings.text_font_weight }};" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 750px) 48vw, calc(100vw - 40px)', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}{%- endif -%}
              <div>{%- if block.settings.eyebrow != blank -%}<p>{{ block.settings.eyebrow | escape }}</p>{%- endif -%}{%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}{%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}</div>
            </article>
          {%- when 'occasion' -%}
            <article class="tg-product-story__occasion" style="--tg-ps-heading-size: {{ block.settings.heading_font_size }}px; --tg-ps-heading-size-mobile: {{ block.settings.heading_font_size_mobile }}px; --tg-ps-heading-weight: {{ block.settings.heading_font_weight }}; --tg-ps-text-size: {{ block.settings.text_font_size }}px; --tg-ps-text-size-mobile: {{ block.settings.text_font_size_mobile }}px; --tg-ps-text-weight: {{ block.settings.text_font_weight }};" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: '68px', loading: 'lazy', alt: '' }}{%- endif -%}
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            </article>
          {%- when 'good_to_know' -%}
            <article class="tg-product-story__know" style="--tg-ps-heading-size: {{ block.settings.heading_font_size }}px; --tg-ps-heading-size-mobile: {{ block.settings.heading_font_size_mobile }}px; --tg-ps-heading-weight: {{ block.settings.heading_font_weight }}; --tg-ps-text-size: {{ block.settings.text_font_size }}px; --tg-ps-text-size-mobile: {{ block.settings.text_font_size_mobile }}px; --tg-ps-text-weight: {{ block.settings.text_font_weight }};" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}<div>{{ block.settings.image | image_url: width: 400 | image_tag: widths: '160, 240, 320, 400', sizes: '(min-width: 750px) 160px, 112px', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}</div>{%- endif -%}
              <span>{%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}{%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}</span>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

