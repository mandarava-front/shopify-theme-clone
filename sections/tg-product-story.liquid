{{ 'tg-product-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="tg-product-story section-{{ section.id }}-padding" style="--tg-product-story-accent: {{ section.settings.accent_color }}; --tg-product-story-text: {{ section.settings.text_color }}; --tg-product-story-surface: {{ section.settings.surface_color }};">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="tg-product-story__header">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<div class="rte">{{ section.settings.subheading }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="tg-product-story__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'hero' -%}
            <article class="tg-product-story__hero" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1800, 2400', sizes: '(min-width: 990px) 1260px, calc(100vw - 40px)', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}
              {%- endif -%}
              <div>
                {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}<a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
              </div>
            </article>
          {%- when 'benefit' -%}
            <article class="tg-product-story__benefit" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, calc(100vw - 40px)', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}{%- endif -%}
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            </article>
          {%- when 'detail' -%}
            <article class="tg-product-story__detail" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 750px) 48vw, calc(100vw - 40px)', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}{%- endif -%}
              <div>{%- if block.settings.eyebrow != blank -%}<p>{{ block.settings.eyebrow | escape }}</p>{%- endif -%}{%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}{%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}</div>
            </article>
          {%- when 'occasion' -%}
            <article class="tg-product-story__occasion" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: '68px', loading: 'lazy', alt: '' }}{%- endif -%}
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            </article>
          {%- when 'good_to_know' -%}
            <article class="tg-product-story__know" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}<div>{{ block.settings.image | image_url: width: 400 | image_tag: widths: '160, 240, 320, 400', sizes: '(min-width: 750px) 160px, 112px', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}</div>{%- endif -%}
              <span>{%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}{%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}</span>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.tg_product.story.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "Why you'll love it", "label": "t:sections.tg_product.story.heading.label" },
    { "type": "richtext", "id": "subheading", "label": "t:sections.tg_product.story.subheading.label" },
    { "type": "color", "id": "surface_color", "default": "#ffffff", "label": "t:sections.tg_product.story.surface_color.label" },
    { "type": "color", "id": "text_color", "default": "#202024", "label": "t:sections.tg_product.story.text_color.label" },
    { "type": "color", "id": "accent_color", "default": "#ee860f", "label": "t:sections.tg_product.story.accent_color.label" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:sections.tg_product.story.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:sections.tg_product.story.padding_bottom.label" }
  ],
  "blocks": [
    { "type": "hero", "name": "t:sections.tg_product.story.blocks.hero.name", "settings": [
      { "type": "image_picker", "id": "image", "label": "t:sections.tg_product.story.blocks.image.label" },
      { "type": "text", "id": "heading", "label": "t:sections.tg_product.story.blocks.heading.label" },
      { "type": "richtext", "id": "text", "label": "t:sections.tg_product.story.blocks.text.label" },
      { "type": "text", "id": "button_label", "label": "t:sections.tg_product.story.blocks.button_label.label" },
      { "type": "url", "id": "button_link", "label": "t:sections.tg_product.story.blocks.button_link.label" }
    ] },
    { "type": "benefit", "name": "t:sections.tg_product.story.blocks.benefit.name", "settings": [
      { "type": "image_picker", "id": "image", "label": "t:sections.tg_product.story.blocks.image.label" },
      { "type": "text", "id": "heading", "label": "t:sections.tg_product.story.blocks.heading.label" },
      { "type": "richtext", "id": "text", "label": "t:sections.tg_product.story.blocks.text.label" }
    ] },
    { "type": "detail", "name": "t:sections.tg_product.story.blocks.detail.name", "settings": [
      { "type": "image_picker", "id": "image", "label": "t:sections.tg_product.story.blocks.image.label" },
      { "type": "text", "id": "eyebrow", "label": "t:sections.tg_product.story.blocks.eyebrow.label" },
      { "type": "text", "id": "heading", "label": "t:sections.tg_product.story.blocks.heading.label" },
      { "type": "richtext", "id": "text", "label": "t:sections.tg_product.story.blocks.text.label" }
    ] },
    { "type": "occasion", "name": "t:sections.tg_product.story.blocks.occasion.name", "settings": [
      { "type": "image_picker", "id": "image", "label": "t:sections.tg_product.story.blocks.image.label" },
      { "type": "text", "id": "heading", "label": "t:sections.tg_product.story.blocks.heading.label" },
      { "type": "richtext", "id": "text", "label": "t:sections.tg_product.story.blocks.text.label" }
    ] },
    { "type": "good_to_know", "name": "t:sections.tg_product.story.blocks.good_to_know.name", "settings": [
      { "type": "image_picker", "id": "image", "label": "t:sections.tg_product.story.blocks.image.label" },
      { "type": "text", "id": "heading", "label": "t:sections.tg_product.story.blocks.heading.label" },
      { "type": "richtext", "id": "text", "label": "t:sections.tg_product.story.blocks.text.label" }
    ] }
  ],
  "presets": [{ "name": "t:sections.tg_product.story.preset.name" }]
}
{% endschema %}
