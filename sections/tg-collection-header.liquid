{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
{{ 'tg-collection.css' | asset_url | stylesheet_tag }}
<section class="tg-collection tg-collection-header" style="--mcc-background: {{ section.settings.background }}; --mcc-text: {{ section.settings.text_color }}; --mcc-muted: {{ section.settings.muted_color }}; --mcc-accent: {{ section.settings.accent_color }}; --mcc-header-top: {{ section.settings.padding_top }}px; --mcc-header-bottom: {{ section.settings.padding_bottom }}px; --mcc-title-size: {{ section.settings.title_font_size }}px; --mcc-title-size-mobile: {{ section.settings.title_font_size_mobile }}px; --mcc-title-weight: {{ section.settings.title_font_weight }}; --mcc-description-size: {{ section.settings.description_font_size }}px; --mcc-description-size-mobile: {{ section.settings.description_font_size_mobile }}px; --mcc-description-weight: {{ section.settings.description_font_weight }};" {{ section.shopify_attributes }}>
  <div class="tg-collection__width">
    {% if section.settings.show_breadcrumbs %}<nav class="tg-collection__breadcrumb" aria-label="{{ 'tg_collection.a11y.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>{% endif %}
    <h1 class="tg-collection__title">{% if section.settings.title != blank %}{{ section.settings.title }}{% else %}{{ collection.title | escape }}{% endif %}</h1>
    {% if section.settings.show_description and collection.description != blank %}<div class="tg-collection__description rte">{{ collection.description }}</div>{% elsif section.settings.description != blank %}<div class="tg-collection__description rte">{{ section.settings.description }}</div>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "t:tg_collection.sections.header.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:tg_collection.settings.show_breadcrumbs",
      "default": false
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "t:tg_collection.settings.home_label",
      "default": "Home"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:tg_collection.settings.title",
      "info": "t:tg_collection.info.title"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "t:tg.settings.title_font_size",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "t:tg.settings.title_font_size_mobile",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "t:tg.settings.title_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:tg_collection.settings.show_collection_description",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:tg_collection.settings.description"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "t:tg.settings.description_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_font_size_mobile",
      "label": "t:tg.settings.description_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "description_font_weight",
      "label": "t:tg.settings.description_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:tg_collection.settings.background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:tg_collection.settings.text_color",
      "default": "#18181e"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "t:tg_collection.settings.muted_color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:tg_collection.settings.accent_color",
      "default": "#ffb700"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:tg_collection.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:tg_collection.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:tg_collection.sections.header.name"
    }
  ]
}
{% endschema %}
