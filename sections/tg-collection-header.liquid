{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
{{ 'tg-collection.css' | asset_url | stylesheet_tag }}
<section class="tg-collection tg-collection-header" style="--mcc-background: {{ section.settings.background }}; --mcc-text: {{ section.settings.text_color }}; --mcc-muted: {{ section.settings.muted_color }}; --mcc-accent: {{ section.settings.accent_color }}; --mcc-header-top: {{ section.settings.padding_top }}px; --mcc-header-bottom: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
  <div class="tg-collection__width">
    {% if section.settings.show_breadcrumbs %}<nav class="tg-collection__breadcrumb" aria-label="{{ 'tg_collection.a11y.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>{% endif %}
    <h1 class="tg-collection__title">{% if section.settings.title != blank %}{{ section.settings.title }}{% else %}{{ collection.title | escape }}{% endif %}</h1>
    {% if section.settings.show_description and collection.description != blank %}<div class="tg-collection__description rte">{{ collection.description }}</div>{% elsif section.settings.description != blank %}<div class="tg-collection__description rte">{{ section.settings.description }}</div>{% endif %}
  </div>
</section>
{% schema %}
{"name":"t:tg_collection.sections.header.name","tag":"section","class":"section","settings":[{"type":"checkbox","id":"show_breadcrumbs","label":"t:tg_collection.settings.show_breadcrumbs","default":false},{"type":"text","id":"home_label","label":"t:tg_collection.settings.home_label","default":"Home"},{"type":"inline_richtext","id":"title","label":"t:tg_collection.settings.title","info":"t:tg_collection.info.title"},{"type":"checkbox","id":"show_description","label":"t:tg_collection.settings.show_collection_description","default":false},{"type":"richtext","id":"description","label":"t:tg_collection.settings.description"},{"type":"color","id":"background","label":"t:tg_collection.settings.background","default":"#ffffff"},{"type":"color","id":"text_color","label":"t:tg_collection.settings.text_color","default":"#18181e"},{"type":"color","id":"muted_color","label":"t:tg_collection.settings.muted_color","default":"#666666"},{"type":"color","id":"accent_color","label":"t:tg_collection.settings.accent_color","default":"#ffb700"},{"type":"range","id":"padding_top","label":"t:tg_collection.settings.padding_top","min":0,"max":120,"step":4,"unit":"px","default":20},{"type":"range","id":"padding_bottom","label":"t:tg_collection.settings.padding_bottom","min":0,"max":120,"step":4,"unit":"px","default":20}],"presets":[{"name":"t:tg_collection.sections.header.name"}]}
{% endschema %}
