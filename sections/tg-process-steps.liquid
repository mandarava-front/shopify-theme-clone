{{ 'tg-sections.css' | asset_url | stylesheet_tag }}
<section class="tg-section tg-process-steps" style="--tg-background: {{ section.settings.background }}; --tg-text: {{ section.settings.text_color }}; --tg-accent: {{ section.settings.accent_color }}; --tg-arrow-color: {{ section.settings.arrow_color }}; --tg-columns: {{ section.settings.columns }}; --tg-padding-top: {{ section.settings.padding_top }}px; --tg-padding-bottom: {{ section.settings.padding_bottom }}px; --tg-mobile-padding-top: {{ section.settings.mobile_padding_top }}px; --tg-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px; --tg-heading-size: {{ section.settings.heading_font_size }}px; --tg-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --tg-heading-weight: {{ section.settings.heading_font_weight }}; --tg-step-title-size: {{ section.settings.title_font_size }}px; --tg-step-title-size-mobile: {{ section.settings.title_font_size_mobile }}px; --tg-step-title-weight: {{ section.settings.title_font_weight }};" {{ section.shopify_attributes }}>
 <div class="tg-page-width"><div class="tg-steps__header">{%- if section.settings.heading != blank -%}<h2 class="tg-heading">{{ section.settings.heading }}</h2>{%- endif -%}</div><div class="tg-steps__grid" data-columns="{{ section.settings.columns }}">
 {%- for block in section.blocks -%}<article class="tg-step" {{ block.shopify_attributes }}>{% if section.settings.show_numbers %}<span class="tg-step__number">{{ forloop.index }}</span>{% endif %}<span class="tg-step__image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: widths: '160, 320, 600', loading: 'lazy', alt: block.settings.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</span><h3 class="tg-step__title">{{ block.settings.title | escape }}</h3>{% if section.settings.show_arrows %}{% unless forloop.last %}<span class="tg-step__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span>{% endunless %}{% endif %}</article>{%- endfor -%}
 </div></div>
</section>
{% schema %}
{
  "name": "t:tg.sections.steps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:tg.settings.heading",
      "default": "How To Custom"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:tg.settings.heading_font_size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:tg.settings.heading_font_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:tg.settings.heading_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "t:tg.settings.title_font_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "t:tg.settings.title_font_size_mobile",
      "min": 7,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "t:tg.settings.title_font_weight",
      "options": [
        {
          "value": "400",
          "label": "t:tg.settings.font_weight_options.regular"
        },
        {
          "value": "500",
          "label": "t:tg.settings.font_weight_options.medium"
        },
        {
          "value": "600",
          "label": "t:tg.settings.font_weight_options.semibold"
        },
        {
          "value": "700",
          "label": "t:tg.settings.font_weight_options.bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "t:tg.settings.show_numbers",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:tg.settings.show_arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:tg.settings.columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:tg.settings.background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:tg.settings.text_color",
      "default": "#18181e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:tg.settings.accent_color",
      "default": "#ffb700"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "t:tg.settings.arrow_color",
      "default": "#18181e"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:tg.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:tg.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:tg.settings.mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:tg.settings.mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:tg.blocks.step.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:tg.settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:tg.settings.title",
          "default": "Choose your favorite"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:tg.sections.steps.name",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
