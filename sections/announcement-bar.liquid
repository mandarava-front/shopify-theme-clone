{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tg_announcement_font_bold = section.settings.tg_announcement_font | font_modify: 'weight', '700'

  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{% style %}
  {{ section.settings.tg_announcement_font | font_face: font_display: 'swap' }}
  {{ tg_announcement_font_bold | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .utility-bar {
    min-height: {{ section.settings.tg_announcement_height }}px;
    color: {{ section.settings.tg_announcement_text_color }};
    background: {{ section.settings.tg_announcement_background_color }};
    background-image: none;
  }

  #shopify-section-{{ section.id }} .announcement-bar,
  #shopify-section-{{ section.id }} .announcement-bar__announcement {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .announcement-bar__message {
    display: flex;
    min-height: {{ section.settings.tg_announcement_height }}px;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    padding: 0.6rem 0;
    color: inherit;
    font-family: {{ section.settings.tg_announcement_font.family }}, {{ section.settings.tg_announcement_font.fallback_families }};
    font-size: {{ section.settings.tg_announcement_font_size }}px;
    font-weight: {{ section.settings.tg_announcement_font_weight }};
    letter-spacing: {{ section.settings.tg_announcement_letter_spacing }}px;
    line-height: {{ section.settings.tg_announcement_line_height }};
    text-transform: {{ section.settings.tg_announcement_text_transform }};
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .announcement-bar__content,
  #shopify-section-{{ section.id }} .announcement-bar__suffix {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .announcement-bar__content a,
  #shopify-section-{{ section.id }} .announcement-bar__suffix a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .announcement-bar__accent {
    color: var(--tg-announcement-accent-color, currentColor);
  }

  #shopify-section-{{ section.id }} .announcement-bar__accent--bold {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .announcement-bar__accent--underline {
    text-decoration: underline;
    text-decoration-thickness: max(1px, 0.08em);
    text-underline-offset: 0.14em;
  }

  #shopify-section-{{ section.id }} .announcement-bar__message .icon-arrow {
    margin-left: 0.35em;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .announcement-bar__message {
      font-size: {{ section.settings.tg_announcement_mobile_font_size }}px;
    }
  }
{% endstyle %}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if section.blocks.size == 1 -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ section.blocks.first.shopify_attributes }}
      >
        {%- if section.blocks.first.settings.content != blank or section.blocks.first.settings.text != blank or section.blocks.first.settings.highlight_text != blank or section.blocks.first.settings.suffix != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message h5">
            {%- if section.blocks.first.settings.content != blank -%}
              <span class="announcement-bar__content">{{ section.blocks.first.settings.content }}</span>
            {%- elsif section.blocks.first.settings.text != blank -%}
              <span class="announcement-bar__content">{{ section.blocks.first.settings.text | escape }}</span>
            {%- endif -%}
            {%- if section.blocks.first.settings.highlight_text != blank -%}
              <span
                class="announcement-bar__accent{% if section.blocks.first.settings.highlight_bold %} announcement-bar__accent--bold{% endif %}{% if section.blocks.first.settings.highlight_underline %} announcement-bar__accent--underline{% endif %}"
                style="--tg-announcement-accent-color: {{ section.blocks.first.settings.highlight_color }};"
              >{{ section.blocks.first.settings.highlight_text | escape }}</span>
            {%- endif -%}
            {%- if section.blocks.first.settings.suffix != blank -%}
              <span class="announcement-bar__suffix">{{ section.blocks.first.settings.suffix }}</span>
            {%- endif -%}
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in section.blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                >
                  {%- if block.settings.content != blank or block.settings.text != blank or block.settings.highlight_text != blank or block.settings.suffix != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      {%- if block.settings.content != blank -%}
                        <span class="announcement-bar__content">{{ block.settings.content }}</span>
                      {%- elsif block.settings.text != blank -%}
                        <span class="announcement-bar__content">{{ block.settings.text | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.highlight_text != blank -%}
                        <span
                          class="announcement-bar__accent{% if block.settings.highlight_bold %} announcement-bar__accent--bold{% endif %}{% if block.settings.highlight_underline %} announcement-bar__accent--underline{% endif %}"
                          style="--tg-announcement-accent-color: {{ block.settings.highlight_color }};"
                        >{{ block.settings.highlight_text | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.suffix != blank -%}
                        <span class="announcement-bar__suffix">{{ block.settings.suffix }}</span>
                      {%- endif -%}
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },    
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "公告栏外观"
    },
    {
      "type": "paragraph",
      "content": "以下颜色优先于上方色彩方案，可为公告栏单独设置视觉样式。"
    },
    {
      "type": "font_picker",
      "id": "tg_announcement_font",
      "label": "字体",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "tg_announcement_font_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "桌面端字体大小",
      "default": 14
    },
    {
      "type": "range",
      "id": "tg_announcement_mobile_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "移动端字体大小",
      "default": 14
    },
    {
      "type": "range",
      "id": "tg_announcement_font_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "常规文字字重",
      "default": 700
    },
    {
      "type": "select",
      "id": "tg_announcement_line_height",
      "label": "行高",
      "options": [
        { "value": "1.2", "label": "紧凑" },
        { "value": "1.4", "label": "标准" },
        { "value": "1.6", "label": "宽松" }
      ],
      "default": "1.4"
    },
    {
      "type": "range",
      "id": "tg_announcement_letter_spacing",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "字间距",
      "default": 0
    },
    {
      "type": "select",
      "id": "tg_announcement_text_transform",
      "label": "文字大小写",
      "options": [
        { "value": "none", "label": "保持原样" },
        { "value": "uppercase", "label": "全部大写" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "tg_announcement_height",
      "min": 32,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "公告栏最小高度",
      "default": 40,
      "info": "文案换行时会自动增高，避免内容被截断。"
    },
    {
      "type": "color",
      "id": "tg_announcement_background_color",
      "label": "背景色",
      "default": "#fef1e2"
    },
    {
      "type": "color",
      "id": "tg_announcement_text_color",
      "label": "文字颜色",
      "default": "#202024"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
         "content": "t:sections.announcement-bar.settings.paragraph.content"
    },             
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "content",
          "label": "公告前置文案",
          "info": "支持在编辑器中对部分文字加粗或添加链接；留空时使用下方原有文案。"
        },
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "公告文案（兼容原有内容）"
        },
        {
          "type": "text",
          "id": "highlight_text",
          "label": "局部强调文案",
          "info": "显示在前置文案之后，可单独设置颜色、粗体和下划线。"
        },
        {
          "type": "color",
          "id": "highlight_color",
          "label": "局部强调颜色",
          "default": "#a50c43"
        },
        {
          "type": "checkbox",
          "id": "highlight_bold",
          "label": "局部强调使用粗体",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "highlight_underline",
          "label": "局部强调添加下划线",
          "default": false
        },
        {
          "type": "inline_richtext",
          "id": "suffix",
          "label": "公告后置文案",
          "info": "可用于在局部强调文案后继续添加文字，也支持局部加粗和链接。"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
