          "default": false
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "t:sections.tg_cart_editor.labels.component_border_color",
          "default": "#E6E1E3"
        },
        {
          "type": "range",
          "id": "block_width",
          "min": 70,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "t:sections.tg_cart_editor.labels.block_width",
          "default": 100
        },
        {
          "type": "range",
          "id": "padding_inline",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "t:sections.tg_cart_editor.labels.component_horizontal_padding",
          "default": 0
        },
        {
          "type": "header",
          "content": "t:sections.tg_cart_editor.labels.block_spacing"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_spacing",
          "label": "t:sections.tg_cart_editor.labels.custom_vertical_margins",
          "info": "t:sections.tg_cart_editor.labels.when_enabled_this_overrides_the_block_default_margins",
          "default": false
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "t:sections.tg_cart_editor.labels.top_margin",
          "default": 24
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "t:sections.tg_cart_editor.labels.bottom_margin",
          "default": 0
        }
      ]
    },
    {
      "type": "subtotal",
      "name": "t:sections.tg_cart_editor.labels.subtotal",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.tg_cart_editor.labels.total_label",
          "default": "Subtotal"
        },
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "t:sections.tg_cart_editor.labels.show_tax_and_shipping_note",
          "default": false
        },
        {
          "type": "textarea",
          "id": "custom_tax_note",
          "label": "t:sections.tg_cart_editor.labels.custom_tax_and_shipping_note"
        },
        {
          "type": "range",
          "id": "block_width",
          "min": 70,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "t:sections.tg_cart_editor.labels.block_width",
          "default": 100
        },
        {
          "type": "header",
          "content": "t:sections.tg_cart_editor.labels.block_spacing"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_spacing",
          "label": "t:sections.tg_cart_editor.labels.custom_vertical_margins",
          "info": "t:sections.tg_cart_editor.labels.when_enabled_this_overrides_the_block_default_margins",
          "default": false
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "t:sections.tg_cart_editor.labels.top_margin",
          "default": 24
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "t:sections.tg_cart_editor.labels.bottom_margin",
          "default": 0
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:sections.tg_cart_editor.labels.checkout_button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "checkout_label",
          "label": "t:sections.tg_cart_editor.labels.checkout_button_label",
          "default": "Proceed to checkout"
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.tg_cart_editor.labels.show_accelerated_checkout",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.tg_cart_editor.labels.checkout_button_appearance"
        },
