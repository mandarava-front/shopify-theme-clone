          "default": "#A50C43"
        },
        {
          "type": "color",
          "id": "track_color",
          "label": "t:sections.tg_cart_editor.labels.progress_track_color",
          "default": "#E9DCE1"
        },
        {
          "type": "color",
          "id": "surface_color",
          "label": "t:sections.tg_cart_editor.labels.component_background_color",
          "default": "#F7F5F6"
        },
        {
          "type": "checkbox",
          "id": "show_border",
