{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{% if section.settings.enable_tg_cart_page_style %}
  {%- assign tg_cart_font_bold = section.settings.tg_cart_font | font_modify: 'weight', '700' -%}
  {% style %}
    {{ section.settings.tg_cart_font | font_face: font_display: 'swap' }}
    {{ tg_cart_font_bold | font_face: font_display: 'swap' }}
  {% endstyle %}
  {{ 'tg-cart-page.css' | asset_url | stylesheet_tag }}
{% endif %}
<script src="{{ 'tg-cart-addons.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tg_cart_protection_requires_terms = false
  assign tg_cart_terms_accepted = false

  if cart.attributes.tg_shipping_protection_terms_accepted == 'true'
    assign tg_cart_terms_accepted = true
  endif

  for block in section.blocks
    if block.type == 'shipping_protection' and block.settings.product != blank and block.settings.require_terms
      assign tg_cart_protection_requires_terms = true
      break
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if section.settings.enable_tg_cart_page_style %} tg-cart-footer{% if section.settings.tg_cart_summary_sticky %} tg-cart-footer--sticky{% endif %}{% endif %}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
  {% if section.settings.enable_tg_cart_page_style %}style="--tg-cart-accent: {{ section.settings.tg_cart_page_accent_color }}; --tg-cart-surface: {{ section.settings.tg_cart_page_surface_color }}; --tg-cart-card: {{ section.settings.tg_cart_page_card_color }}; --tg-cart-summary-surface: {{ section.settings.tg_cart_summary_surface_color }}; --tg-cart-border: {{ section.settings.tg_cart_page_border_color }}; --tg-cart-text: {{ section.settings.tg_cart_page_text_color }}; --tg-cart-muted: {{ section.settings.tg_cart_page_muted_color }}; --tg-cart-total-price-color: {{ section.settings.tg_cart_total_price_color }}; --tg-cart-radius: {{ section.settings.tg_cart_card_radius }}px; --tg-cart-summary-width: {{ section.settings.tg_cart_summary_width }}px; --tg-cart-summary-padding-block: {{ section.settings.tg_cart_summary_padding_block }}px; --tg-cart-summary-padding-inline: {{ section.settings.tg_cart_summary_padding_inline }}px; --tg-cart-font: {{ section.settings.tg_cart_font.family }}, {{ section.settings.tg_cart_font.fallback_families }};"{% endif %}
>
  <div class="page-width">
    <div class="cart__footer tg-cart-summary isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note and section.settings.tg_cart_show_note -%}
        <cart-note class="cart__note tg-cart-summary__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks tg-cart-summary__blocks">
        <div class="tg-cart-summary__primary">
        {% for block in section.blocks %}
          {%- unless block.type == 'buyer_protection' -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- else -%}
              <div
                class="tg-cart-summary__block{% if block.settings.enable_custom_spacing %} tg-cart-summary__block--custom-spacing{% endif %}"
                style="--tg-cart-block-width: {{ block.settings.block_width | default: 100 }}%; --tg-cart-block-margin-top: {{ block.settings.margin_top | default: 0 }}px; --tg-cart-block-margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;"
                {{ block.shopify_attributes }}
              >
              {%- case block.type -%}
                {%- when 'promotion' -%}
                  {% render 'tg-cart-promotion', block: block, cart: cart %}
                {%- when 'free_shipping_progress' -%}
                  {% render 'tg-cart-free-shipping', block: block, cart: cart, surface: 'page' %}
                {%- when 'subtotal' -%}
                  <div class="js-contents tg-cart-summary__totals">
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                          {{ discount.title | escape }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals tg-cart-summary__total-row">
                  <h2 class="totals__total">
                    {% if block.settings.label != blank %}
                      {{ block.settings.label | escape }}
                    {% else %}
                      {{ 'sections.cart.estimated_total' | t }}
                    {% endif %}
                  </h2>
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
                </div>

                {% if block.settings.show_tax_note %}
                  <small class="tax-note tg-cart-summary__tax-note caption-large rte">
                  {% if block.settings.custom_tax_note != blank %}
                    {{ block.settings.custom_tax_note | escape }}
                  {% else %}
                  {%- if cart.duties_included and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- endif -%}
                  {% endif %}
                  </small>
                {% endif %}
                  </div>
                {%- when 'buttons' -%}
                  <div
                    class="cart__ctas tg-cart-summary__ctas"
                    style="--tg-cart-checkout-background: {{ block.settings.checkout_background_color }}; --tg-cart-checkout-hover-background: {{ block.settings.checkout_hover_background_color }}; --tg-cart-checkout-text: {{ block.settings.checkout_text_color }}; --tg-cart-checkout-border: {{ block.settings.checkout_border_color }}; --tg-cart-checkout-border-width: {{ block.settings.checkout_border_width }}px; --tg-cart-checkout-radius: {{ block.settings.checkout_radius }}px; --tg-cart-checkout-height: {{ block.settings.checkout_height }}px; --tg-cart-checkout-font-size: {{ block.settings.checkout_font_size }}px;"
                  >
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  data-tg-cart-checkout
                  {% if cart == empty %}
                    disabled
                  {% elsif tg_cart_protection_requires_terms and tg_cart_terms_accepted == false %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {% if block.settings.checkout_label != blank %}
                    {{ block.settings.checkout_label | escape }}
                  {% else %}
                    {{ 'sections.cart.checkout' | t }}
                  {% endif %}
                </button>
                  </div>

                  {%- if additional_checkout_buttons and block.settings.show_dynamic_checkout -%}
                    <div
                      class="cart__dynamic-checkout-buttons additional-checkout-buttons{% if tg_cart_protection_requires_terms and tg_cart_terms_accepted == false %} is-disabled{% endif %}"
                      data-tg-cart-dynamic-checkout
                      {% if tg_cart_protection_requires_terms and tg_cart_terms_accepted == false %}
                        aria-hidden="true"
                        inert
                      {% endif %}
                    >
                      {{ content_for_additional_checkout_buttons }}
                    </div>
                  {%- endif -%}
                {%- when 'payment_methods' -%}
                  {% render 'tg-cart-payment-methods', block: block %}
                {%- when 'shipping_protection' -%}
                  {% render 'tg-cart-shipping-protection', block: block, cart: cart, surface: 'page' %}
                {%- when 'assurance' -%}
                  <div class="tg-cart-assurance">
                    <span class="svg-wrapper" aria-hidden="true">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                    <div>
                      <strong>{{ block.settings.heading | escape }}</strong>
                      {%- if block.settings.text != blank -%}
                        <div class="rte">{{ block.settings.text }}</div>
                      {%- endif -%}
                      {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                        <a class="link underlined-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
              </div>
            {%- endif -%}
          {%- endunless -%}
        {% endfor %}

        <div id="cart-errors"></div>
        </div>

        {% for block in section.blocks %}
          {%- if block.type == 'buyer_protection' -%}
            <div
              class="tg-cart-summary__block{% if block.settings.enable_custom_spacing %} tg-cart-summary__block--custom-spacing{% endif %}"
              style="--tg-cart-block-width: {{ block.settings.block_width | default: 100 }}%; --tg-cart-block-margin-top: {{ block.settings.margin_top | default: 0 }}px; --tg-cart-block-margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;"
              {{ block.shopify_attributes }}
            >
              {% render 'tg-cart-buyer-protection', block: block %}
            </div>
          {%- endif -%}
        {% endfor %}

        {%- if section.settings.tg_cart_show_continue_link -%}
          <a
            class="tg-cart-summary__continue"
            href="{% if section.settings.tg_cart_continue_link != blank %}{{ section.settings.tg_cart_continue_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          >
            <span class="tg-cart-inline-icon" aria-hidden="true">{{- 'icon-discount.svg' | inline_asset_content -}}</span>
            {{ section.settings.tg_cart_continue_label | default: 'Keep shopping' | escape }}
          </a>
        {%- endif -%}

        {%- if request.page_type == 'cart' -%}
          <template data-tg-cart-drawer-addons-template>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'free_shipping_progress' -%}
                  {% render 'tg-cart-free-shipping', block: block, cart: cart, surface: 'drawer' %}
                {%- when 'shipping_protection' -%}
                  {% render 'tg-cart-shipping-protection', block: block, cart: cart, surface: 'drawer' %}
              {%- endcase -%}
            {%- endfor -%}
          </template>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.tg_cart_editor.labels.cart_summary",
  "class": "cart__footer-wrapper tg-cart-footer-section",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_tg_cart_page_style",
      "label": "t:sections.tg_cart_editor.labels.enable_prints10_summary",
      "info": "t:sections.tg_cart_editor.labels.keep_shopify_checkout_and_cart_updates",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "tg_cart_show_note",
      "label": "t:sections.tg_cart_editor.labels.show_cart_note",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "tg_cart_show_continue_link",
      "label": "t:sections.tg_cart_editor.labels.show_continue_shopping_link",
      "default": true
    },
    {
      "type": "text",
      "id": "tg_cart_continue_label",
      "label": "t:sections.tg_cart_editor.labels.continue_shopping_label",
      "default": "Keep shopping"
    },
    {
      "type": "url",
      "id": "tg_cart_continue_link",
      "label": "t:sections.tg_cart_editor.labels.continue_shopping_link"
    },
    {
      "type": "checkbox",
      "id": "tg_cart_summary_sticky",
      "label": "t:sections.tg_cart_editor.labels.sticky_summary_on_desktop",
      "default": true
    },
    {
      "type": "range",
      "id": "tg_cart_summary_width",
      "min": 340,
      "max": 560,
      "step": 10,
      "unit": "px",
      "label": "t:sections.tg_cart_editor.labels.summary_width",
      "default": 480
    },
    {
      "type": "header",
      "content": "t:sections.tg_cart_editor.labels.summary_spacing"
    },
    {
      "type": "range",
      "id": "tg_cart_summary_padding_block",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "t:sections.tg_cart_editor.labels.vertical_padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "tg_cart_summary_padding_inline",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "t:sections.tg_cart_editor.labels.horizontal_padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.tg_cart_editor.labels.summary_appearance"
    },
    {
      "type": "font_picker",
      "id": "tg_cart_font",
      "label": "t:sections.tg_cart_editor.labels.cart_font",
      "default": "poppins_n4"
    },
    {
      "type": "color",
      "id": "tg_cart_page_accent_color",
      "label": "t:sections.tg_cart_editor.labels.accent_color",
      "default": "#A50C43"
    },
    {
      "type": "color",
      "id": "tg_cart_page_surface_color",
      "label": "t:sections.tg_cart_editor.labels.page_background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tg_cart_page_card_color",
      "label": "t:sections.tg_cart_editor.labels.item_card_background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tg_cart_summary_surface_color",
      "label": "t:sections.tg_cart_editor.labels.summary_background",
      "default": "#F7F5F6"
    },
    {
      "type": "color",
      "id": "tg_cart_total_price_color",
      "label": "t:sections.tg_cart_editor.labels.total_price_color",
      "default": "#A50C43"
    },
    {
      "type": "color",
      "id": "tg_cart_page_border_color",
      "label": "t:sections.tg_cart_editor.labels.border_color",
      "default": "#E6E1E3"
    },
    {
      "type": "color",
      "id": "tg_cart_page_text_color",
      "label": "t:sections.tg_cart_editor.labels.primary_text_color",
      "default": "#1F2933"
    },
    {
      "type": "color",
      "id": "tg_cart_page_muted_color",
      "label": "t:sections.tg_cart_editor.labels.secondary_text_color",
      "default": "#667085"
    },
    {
      "type": "range",
      "id": "tg_cart_card_radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "t:sections.tg_cart_editor.labels.card_corner_radius",
      "default": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
