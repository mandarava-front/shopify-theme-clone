{{ 'tg-order-tracking.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tg-order-tracking.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tracking_endpoint = section.settings.proxy_endpoint | strip
  assign tracking_configured = false
  if tracking_endpoint != blank
    assign tracking_configured = true
  endif
-%}

<section
  class="tg-order-tracking color-{{ section.settings.color_scheme }} gradient"
  style="--tracking-padding-top: {{ section.settings.padding_top }}px; --tracking-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
>
  <div class="tg-order-tracking__shell page-width">
    <order-tracking class="tg-order-tracking__component" data-configured="{{ tracking_configured }}">
      <div class="tg-order-tracking__card tg-order-tracking__form-card">
        <div class="tg-order-tracking__form-layout">
          <header class="tg-order-tracking__intro">
            <span class="tg-order-tracking__intro-icon" aria-hidden="true">
              {{- 'tg-icon-track-order.svg' | inline_asset_content -}}
            </span>
            {%- if section.settings.heading != blank -%}
              <h1 class="tg-order-tracking__heading">{{ section.settings.heading | escape }}</h1>
            {%- endif -%}
            {%- if section.settings.subtitle != blank -%}
              <p class="tg-order-tracking__subtitle">{{ section.settings.subtitle | escape }}</p>
            {%- endif -%}
          </header>

          <form class="tg-order-tracking__form" data-tracking-form novalidate>
            <div class="tg-order-tracking__field">
              <label for="TrackingOrderNumber-{{ section.id }}">
                {{ section.settings.order_number_label | escape }}
                <span aria-hidden="true">*</span>
              </label>
              <input
                id="TrackingOrderNumber-{{ section.id }}"
                class="tg-order-tracking__input"
                type="text"
                name="orderNumber"
                placeholder="{{ section.settings.order_number_placeholder | escape }}"
                autocomplete="off"
                autocapitalize="characters"
                aria-describedby="TrackingOrderNumberError-{{ section.id }}"
                required
                {% unless tracking_configured %}disabled{% endunless %}
              >
              <p
                id="TrackingOrderNumberError-{{ section.id }}"
                class="tg-order-tracking__field-error"
                data-field-error="orderNumber"
                aria-live="polite"
                hidden
              ></p>
            </div>

            <div class="tg-order-tracking__field">
              <label for="TrackingEmail-{{ section.id }}">
                {{ section.settings.email_label | escape }}
                <span aria-hidden="true">*</span>
              </label>
              <input
                id="TrackingEmail-{{ section.id }}"
                class="tg-order-tracking__input"
                type="email"
                name="email"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                autocomplete="email"
                autocapitalize="none"
                spellcheck="false"
                aria-describedby="TrackingEmailError-{{ section.id }}"
                required
                {% unless tracking_configured %}disabled{% endunless %}
              >
              <p
                id="TrackingEmailError-{{ section.id }}"
                class="tg-order-tracking__field-error"
                data-field-error="email"
                aria-live="polite"
                hidden
              ></p>
            </div>

            <button
              class="tg-order-tracking__submit"
              type="submit"
              data-submit-button
              {% unless tracking_configured %}disabled{% endunless %}
            >
              <span data-submit-label>{{ section.settings.submit_label | escape }}</span>
              <span class="tg-order-tracking__spinner" data-submit-spinner aria-hidden="true" hidden></span>
            </button>

            <p class="tg-order-tracking__form-status" data-form-status role="status" aria-live="polite"></p>
          </form>
        </div>

        <div
          class="tg-order-tracking__message tg-order-tracking__message--maintenance"
          data-maintenance-message
          role="status"
          {% if tracking_configured %}hidden{% endif %}
        >
          <span class="tg-order-tracking__message-icon" aria-hidden="true">
            {{- 'icon-info.svg' | inline_asset_content -}}
          </span>
          <span>Order tracking is temporarily unavailable. Please check back soon.</span>
        </div>

        {%- if request.design_mode and tracking_endpoint == blank -%}
          <p class="tg-order-tracking__editor-note">
            Theme editor: add the Shopify App Proxy path in the "Proxy endpoint" setting to enable tracking.
          </p>
        {%- endif -%}
      </div>

      <div class="tg-order-tracking__results" data-tracking-results tabindex="-1" hidden></div>

      <dialog class="tg-order-tracking__dialog" data-tracking-dialog>
        <div class="tg-order-tracking__dialog-inner" data-dialog-inner>
          <button
            type="button"
            class="tg-order-tracking__dialog-close"
            data-dialog-close
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="tg-order-tracking__dialog-body" data-dialog-body></div>
        </div>
      </dialog>

      <template data-icon-template="copy">
        {{- 'icon-copy.svg' | inline_asset_content -}}
      </template>
      <template data-icon-template="check">
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
      </template>
      <template data-icon-template="arrow">
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </template>
      <template data-icon-template="info">
        {{- 'icon-info.svg' | inline_asset_content -}}
      </template>

      <script type="application/json" data-tracking-config>
        {
          "endpoint": {{ tracking_endpoint | json }},
          "locale": {{ request.locale.iso_code | json }},
          "contactUrl": {{ section.settings.contact_page.url | json }},
          "submitLabel": {{ section.settings.submit_label | json }},
          "messages": {
            "noShipmentTitle": {{ section.settings.no_shipment_title | json }},
            "noShipment": {{ section.settings.no_shipment_message | json }},
            "notFoundTitle": {{ section.settings.not_found_title | json }},
            "notFound": {{ section.settings.not_found_message | json }},
            "noActivity": {{ section.settings.no_activity_message | json }},
            "unavailable": {{ section.settings.unavailable_message | json }}
          }
        }
      </script>
    </order-tracking>
  </div>
</section>

{% schema %}
{
  "name": "t:tg_order_tracking.sections.main.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "proxy_endpoint",
      "label": "t:tg_order_tracking.settings.proxy_endpoint",
      "info": "t:tg_order_tracking.info.proxy_endpoint",
      "default": "https://scm.order-api.com/api/erp/tracking/query"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:tg.settings.heading",
      "default": "Track Your Order"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:tg.settings.description",
      "default": "Enter the order number and email address used at checkout to see the latest delivery updates."
    },
    {
      "type": "text",
      "id": "order_number_label",
      "label": "t:tg_order_tracking.settings.order_number_label",
      "default": "Order Number"
    },
    {
      "type": "text",
      "id": "order_number_placeholder",
      "label": "t:tg_order_tracking.settings.order_number_placeholder",
      "default": "Example: #TG123456"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "t:tg_order_tracking.settings.email_label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:tg_order_tracking.settings.email_placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:tg.settings.button_label",
      "default": "TRACK ORDER"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "t:tg_order_tracking.settings.contact_page"
    },
    {
      "type": "header",
      "content": "t:tg_order_tracking.headers.messages",
      "info": "t:tg_order_tracking.info.messages"
    },
    {
      "type": "text",
      "id": "no_shipment_title",
      "label": "t:tg_order_tracking.settings.no_shipment_title",
      "default": "Your order is being prepared"
    },
    {
      "type": "textarea",
      "id": "no_shipment_message",
      "label": "t:tg_order_tracking.settings.no_shipment_message",
      "info": "t:tg_order_tracking.info.no_shipment_message",
      "default": "Good news — we found your order! It has not shipped yet, so there is no tracking information available. Your items are still being produced and packed at our workshop. As soon as the carrier collects your parcel, the tracking number will appear here and we will email it to you."
    },
    {
      "type": "text",
      "id": "not_found_title",
      "label": "t:tg_order_tracking.settings.not_found_title",
      "default": "We could not find that order"
    },
    {
      "type": "textarea",
      "id": "not_found_message",
      "label": "t:tg_order_tracking.settings.not_found_message",
      "info": "t:tg_order_tracking.info.not_found_message",
      "default": "Please check that the order number is complete (for example #TG123456) and that the email address matches the one on your order confirmation. Orders placed in the last few minutes may take a little while to appear."
    },
    {
      "type": "textarea",
      "id": "no_activity_message",
      "label": "t:tg_order_tracking.settings.no_activity_message",
      "info": "t:tg_order_tracking.info.no_activity_message",
      "default": "The carrier has accepted your parcel but has not published any scans yet. Tracking events usually appear within 24-48 hours."
    },
    {
      "type": "textarea",
      "id": "unavailable_message",
      "label": "t:tg_order_tracking.settings.unavailable_message",
      "info": "t:tg_order_tracking.info.unavailable_message",
      "default": "We cannot retrieve tracking details right now. Please try again in a few minutes."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:tg.settings.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:tg.settings.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:tg_order_tracking.sections.main.name"
    }
  ]
}
{% endschema %}
