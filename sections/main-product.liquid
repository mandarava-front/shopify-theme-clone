  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {%- assign teeinblue_button_color = settings.tg_teeinblue_button_color | default: '#FFC400' -%}
  {%- assign teeinblue_form_header_background = settings.tg_teeinblue_form_header_background | default: '#FFFFFF' -%}
  {%- assign teeinblue_form_content_background = settings.tg_teeinblue_form_content_background | default: '#FFFFFF' -%}

  {%- comment -%}
    Campaigns by Product Bases render their own complete option UI, so the
    theme's native variant picker is a duplicate of it. Hide the picker
    visually but keep it in the DOM: its radios/selects are what the theme's
    product form submits, and the script below keeps them in sync.
    Campaigns by Shopify products and plain products keep the native picker.
  {%- endcomment -%}
  <style id="TeeInBlueProductBasePicker">
    product-info[data-tg-teeinblue-product-base] variant-selects {
      display: none !important;
    }
  </style>

  <script>
    (() => {
      const productRoot = document.getElementById('MainProduct-{{ section.id }}');
      if (!productRoot) return;

      const previousTeardown = window.TgTeeInBlueProductBaseTeardown;
      if (previousTeardown) previousTeardown();

      const normalizeOptionText = (value) => String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();

      const getThemeControlForValue = (group, optionValue) => {
        const normalizedValue = normalizeOptionText(optionValue);
        if (!normalizedValue) return;

        const radio = [...group.querySelectorAll('input[type="radio"]')].find(
          (input) => normalizeOptionText(input.value) === normalizedValue
        );
        if (radio) {
          return {
            control: radio,
            isSelected: radio.checked,
            select: () => {
              radio.checked = true;
            },
          };
        }

        const select = group.querySelector('select');
        const matchingOption = [...(select?.options || [])].find(
          (option) => normalizeOptionText(option.value) === normalizedValue
        );
        if (!select || !matchingOption) return;

        return {
          control: select,
          isSelected: select.value === matchingOption.value,
          select: () => {
            select.value = matchingOption.value;
          },
        };
      };

      const isCurrentProductCampaign = (campaign) =>
        !campaign.productId ||
        !productRoot.dataset.productId ||
        String(campaign.productId) === productRoot.dataset.productId;

      {%- comment -%}
        `isPlatformProduct` marks a Campaign by Shopify products, so a TeeInBlue
        product with it false is a Campaign by Product Bases. TeeInBlue publishes
        the campaign in the document head, before this section renders, so it is
        the authority over the metafield marker Liquid added above: it both sets
        the marker and clears a wrong one. Returns whether it could decide.
      {%- endcomment -%}
      const getProductBaseVerdict = () => {
        const campaign = window.teeinblueCampaign;
        if (!campaign || campaign.isTeeInBlueProduct === undefined || !isCurrentProductCampaign(campaign)) {
          return;
        }
        return campaign.isTeeInBlueProduct === true && campaign.isPlatformProduct === false;
      };

      const applyProductBaseState = () => {
        const isProductBase = getProductBaseVerdict();
        if (isProductBase === undefined) return false;

        if (isProductBase) productRoot.dataset.tgTeeinblueProductBase = 'true';
        else productRoot.removeAttribute('data-tg-teeinblue-product-base');
        return true;
      };

      /* TeeInBlue owns the selection for Product Bases, but the hidden theme
         controls are what the product form posts, so mirror its variant onto
         them. Shopify products campaigns keep the visible picker in sync the
         same way. */
      const syncTeeInBlueVariantToTheme = (event) => {
        const campaign = window.teeinblueCampaign;
        const variantId = String(event.detail?.variantId || '');
        if (!variantId || !campaign || !isCurrentProductCampaign(campaign)) return;

        applyProductBaseState();

        const variant = campaign.variantsById?.[variantId];
        if (!variant) return;

        const themeGroups = [...productRoot.querySelectorAll('variant-selects .product-form__input')];
        const optionValues = Array.isArray(variant.options)
          ? variant.options
          : themeGroups.map((_, index) => variant[`option${index + 1}`]);
        if (!themeGroups.length || optionValues.length < themeGroups.length) return;

        const themeControls = themeGroups.map((group, index) =>
          getThemeControlForValue(group, optionValues[index])
        );
        if (themeControls.some((entry) => !entry)) return;

        const changedControls = themeControls.filter((entry) => !entry.isSelected);
        if (!changedControls.length) return;

        changedControls.forEach((entry) => entry.select());
        changedControls[changedControls.length - 1].control.dispatchEvent(
          new Event('change', { bubbles: true })
        );
      };

      document.addEventListener('teeinblue-event-variant-changed', syncTeeInBlueVariantToTheme);

      /* The app embed normally publishes the campaign in the head, so the verdict
         is already in before the picker paints. Poll only for the case where the
         embed sits after this section. */
      let pollTimer;
      if (!applyProductBaseState()) {
        const deadline = Date.now() + 20000;
        pollTimer = window.setInterval(() => {
          if (applyProductBaseState() || Date.now() > deadline) {
            window.clearInterval(pollTimer);
            pollTimer = undefined;
          }
        }, 200);
      }

      window.TgTeeInBlueProductBaseTeardown = () => {
        document.removeEventListener('teeinblue-event-variant-changed', syncTeeInBlueVariantToTheme);
        if (pollTimer) window.clearInterval(pollTimer);
        window.TgTeeInBlueProductBaseTeardown = undefined;
      };
    })();
  </script>

  {%- comment -%}
    TeeInBlue settings might be absent in an existing settings_data.json until
    the merchant saves the Theme settings once. Treat an absent checkbox as its
    schema default (enabled); an explicitly saved false still disables it.
  {%- endcomment -%}
  {%- if settings.tg_teeinblue_overrides_enabled != false -%}
    <style id="TeeInBlueOverrides">
      {%- if settings.tg_teeinblue_hide_unavailable_options != false -%}
        /* TeeInBlue owns availability and selection. Follow its reactive marker,
           retaining the sold-out presentation when every value is unavailable.
           Hide the whole radio wrapper so its input also leaves the tab order. */
        #MainProduct-{{ section.id }} #tee-artwork-form .tee-option-inner:has(> .tee-radio:not(.tee-radio--unavailable)) > .tee-radio--unavailable {
          display: none !important;
        }
      {%- endif -%}

      {%- if settings.tg_teeinblue_hide_price != false -%}
        body:has(main[data-template='product']) .tee-block.tee-product-price {
          display: none !important;
        }
      {%- endif -%}

      {%- if settings.tg_teeinblue_hide_form_actions != false -%}
        body:has(main[data-template='product']) #teeFormActions.tee-form-actions {
          display: none !important;
        }
      {%- endif -%}

      {%- if settings.tg_teeinblue_hide_description != false -%}
        body:has(main[data-template='product']) .tee-block.tee-description {
          display: none !important;
        }
      {%- endif -%}

    </style>

    <script>
      (() => {
        if (!document.querySelector('main[data-template="product"]')) return;

        const previousObserver = window.TgTeeInBlueColorOverrideObserver;
        if (previousObserver) previousObserver.disconnect();

        const buttonColor = {{ teeinblue_button_color | json }};
        const headerBackground = {{ teeinblue_form_header_background | json }};
        const contentBackground = {{ teeinblue_form_content_background | json }};
        const overrides = [
          ['.teeinblue-theme-modern .tee-progress.tee-progress--loading > .tee-progress-bar', 'background', buttonColor],
          ['.teeinblue-theme-modern .tee-progress-percent.text-dark', 'color', buttonColor],
          ['.teeinblue-theme-modern .tee-photo-action .tee-btn.tee-btn--recustomize', 'color', buttonColor],
          ['.teeinblue-theme-modern .tee-field--photo .tee-photo-action > label.tee-btn.tee-btn--upload', 'background', buttonColor],
          ['.teeinblue-theme-modern button.tee-btn.tee-btn--sm.tee-btn--rounded.tee-btn--primary', 'background', buttonColor],
          ['#tee-artwork-form > .tee-customize-main-form > .tee-form-header', 'background', headerBackground],
          ['#tee-artwork-form > .tee-customize-main-form > #teeFormInputs.tee-customization-form', 'background', contentBackground],
        ];

        const applyOverrides = () => {
          if (!document.querySelector('main[data-template="product"]')) return;

          overrides.forEach(([selector, property, value]) => {
            document.querySelectorAll(selector).forEach((element) => {
              const markerName = property === 'background' ? 'tgTeeinblueBackground' : 'tgTeeinblueColor';
              const currentValue = element.style.getPropertyValue(property).trim();
              const marker = `${value}::${currentValue}`;

              if (
                element.dataset[markerName] !== marker ||
                element.style.getPropertyPriority(property) !== 'important'
              ) {
                element.style.setProperty(property, value, 'important');
                element.dataset[markerName] = `${value}::${element.style.getPropertyValue(property).trim()}`;
              }
            });
          });
        };

        let animationFrame;
        const scheduleOverrides = () => {
          if (animationFrame) return;
          animationFrame = window.requestAnimationFrame(() => {
            animationFrame = undefined;
            applyOverrides();
          });
        };

        /* TeeInBlue replaces fields and modal contents dynamically. Reapply
           only when it inserts a node or changes an inline style/class. */
        const observer = new MutationObserver(scheduleOverrides);
        observer.observe(document.documentElement, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['class', 'style'],
        });
        window.TgTeeInBlueColorOverrideObserver = observer;

        applyOverrides();
      })();
    </script>
  {%- endif -%}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'tg-product.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
    {%- if section.settings.enable_tg_product_style -%}
    {%- liquid
      assign tg_variant_block = section.blocks | where: 'type', 'variant_picker' | first
      assign tg_product_font_500 = section.settings.tg_product_font | font_modify: 'weight', '500'
      assign tg_product_font_600 = section.settings.tg_product_font | font_modify: 'weight', '600'
      assign tg_product_font_700 = section.settings.tg_product_font | font_modify: 'weight', '700'
    -%}
    {%- style -%}
      #MainProduct-{{ section.id }} { --tg-option-text: {{ tg_variant_block.settings.option_text | default: '#000000' }}; --tg-option-bg: {{ tg_variant_block.settings.option_background | default: '#FFFFFF' }}; --tg-option-border: {{ tg_variant_block.settings.option_border | default: '#CCCCCC' }}; --tg-option-selected-bg: {{ tg_variant_block.settings.option_selected_background | default: '#000000' }}; --tg-option-selected-text: {{ tg_variant_block.settings.option_selected_text | default: '#FFFFFF' }}; --tg-option-radius: {{ tg_variant_block.settings.option_radius | default: 8 }}px; }
      {{ section.settings.tg_product_font | font_face: font_display: 'swap' }}
      {{ tg_product_font_500 | font_face: font_display: 'swap' }}
      {{ tg_product_font_600 | font_face: font_display: 'swap' }}
      {{ tg_product_font_700 | font_face: font_display: 'swap' }}
    {%- endstyle -%}
    {{ 'tg-product-design.css' | asset_url | stylesheet_tag }}
    {{ 'tg-product-gallery-design.css' | asset_url | stylesheet_tag }}
    {{ 'tg-product-info-design.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'tg-product-gallery-design.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <div class="page-width">
      {%- if section.settings.show_breadcrumbs -%}
        <nav class="tg-breadcrumb tg-product-breadcrumb" style="{% render 'tg-breadcrumb-text-style', section: section %}" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label | escape }}</a>
          <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          {%- if product.collections.first -%}
            <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
            <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          {%- endif -%}
          <span aria-current="page">{{ product.title | escape }}</span>
        </nav>
      {%- endif -%}
      <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
        <div class="grid__item product__media-wrapper{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}">
          {% render 'product-media-gallery', variant_images: variant_images %}
        </div>
        <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <section
            id="ProductInfo-{{ section.id }}"
            class="product__info-container"
          >
            {%- assign product_form_id = 'product-form-' | append: section.id -%}
            {%- assign quantity_selector_block = section.blocks | where: 'type', 'quantity_selector' | first -%}
            {%- assign inline_purchase_actions = false -%}
            {%- if section.settings.purchase_actions_layout == 'inline' and quantity_selector_block != blank -%}
              {%- unless product.quantity_price_breaks_configured? -%}
                {%- assign inline_purchase_actions = true -%}
              {%- endunless -%}
            {%- endif -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'text' -%}
                  <p
                    class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </p>
                {%- when 'title' -%}
                  <div
                    class="product__title tg-product-title{% if block.settings.enable_tg_title_style %} tg-product-title--styled{% endif %}"
                    {% if block.settings.enable_tg_title_style %}
                      style="--tg-product-title-color: {{ block.settings.title_color }}; --tg-product-title-size: {{ block.settings.title_font_size }}px; --tg-product-title-size-mobile: {{ block.settings.title_font_size_mobile }}px; --tg-product-title-weight: {{ block.settings.title_font_weight }}; --tg-product-title-line-height: {{ block.settings.title_line_height | default: 150 | divided_by: 100.0 }};{% if block.settings.title_letter_spacing != blank and block.settings.title_letter_spacing != 0 %} --tg-product-title-letter-spacing: {{ block.settings.title_letter_spacing | divided_by: 100.0 }}em;{% endif %} --tg-product-title-transform: {{ block.settings.title_text_transform | default: 'none' }};"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <h1>{{ product.title | escape }}</h1>
                    <a href="{{ product.url }}" class="product__title">
                      <h2 class="h1">
                        {{ product.title | escape }}
                      </h2>
                    </a>
                  </div>
                {%- when 'price' -%}
                  <div
                    id="price-{{ section.id }}"
                    class="tg-product-price"
                    role="status"
                    style="--tg-price-size: {{ block.settings.price_font_size | default: 24 | divided_by: 10.0 }}rem; --tg-price-size-mobile: {{ block.settings.price_font_size_mobile | default: 24 | divided_by: 10.0 }}rem; --tg-price-weight: {{ block.settings.price_font_weight | default: '700' }}; --tg-price-color: {{ block.settings.price_color | default: '#102a43' }};{% if block.settings.price_letter_spacing != blank and block.settings.price_letter_spacing != 0 %} --tg-price-letter-spacing: {{ block.settings.price_letter_spacing | divided_by: 100.0 }}em;{% endif %} --tg-price-compare-size: {{ block.settings.compare_price_font_size | default: 24 | divided_by: 10.0 }}rem; --tg-price-compare-size-mobile: {{ block.settings.compare_price_font_size_mobile | default: 24 | divided_by: 10.0 }}rem; --tg-price-compare-weight: {{ block.settings.compare_price_font_weight | default: '700' }}; --tg-price-compare-color: {{ block.settings.compare_price_color | default: '#102a43' }};{% if block.settings.compare_price_letter_spacing != blank and block.settings.compare_price_letter_spacing != 0 %} --tg-price-compare-letter-spacing: {{ block.settings.compare_price_letter_spacing | divided_by: 100.0 }}em;{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- render 'price',
                      product: product,
                      use_variant: true,
                      show_badges: true,
                      price_class: 'price--large'
                    -%}
                    {%- if section.settings.enable_tg_product_style -%}
                      {%- assign tg_price_variant = product.selected_or_first_available_variant -%}
                      {%- if tg_price_variant.compare_at_price > tg_price_variant.price -%}
                        {%- assign tg_discount_percent = tg_price_variant.compare_at_price | minus: tg_price_variant.price | times: 100.0 | divided_by: tg_price_variant.compare_at_price | round -%}
                        <span class="tg-product-discount" aria-label="{{ tg_discount_percent }}% {{ 'products.product.on_sale' | t }}">-{{ tg_discount_percent }}%</span>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                  {%- if product.quantity_price_breaks_configured? -%}
                    <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                      <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                    </div>
                  {%- endif -%}
                  {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                    <div class="product__tax caption rte">
                      {%- if cart.duties_included and cart.taxes_included -%}
                        {{ 'products.product.duties_and_taxes_included' | t }}
                      {%- elsif cart.taxes_included -%}
                        {{ 'products.product.taxes_included' | t }}
                      {%- elsif cart.duties_included -%}
                        {{ 'products.product.duties_included' | t }}
                      {%- endif -%}
                      {%- if shop.shipping_policy.body != blank -%}
                        {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- unless section.settings.enable_tg_product_style -%}
                  <div {{ block.shopify_attributes }}>
                    {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                    {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      {{ form | payment_terms }}
                    {%- endform -%}
                  </div>
                  {%- endunless -%}
                {%- when 'inventory' -%}
                  <p
                    class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                    {{ block.shopify_attributes }}
                    id="Inventory-{{ section.id }}"
                    role="status"
                  >
                    {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                        {%- if product.selected_or_first_available_variant.inventory_quantity
                            <= block.settings.inventory_threshold
                        -%}
                          <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {%- if block.settings.show_inventory_quantity -%}
                            {{-
                              'products.product.inventory_low_stock_show_count'
                              | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                            -}}
                          {%- else -%}
                            {{- 'products.product.inventory_low_stock' | t -}}
                          {%- endif -%}
                        {%- else -%}
                          <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {%- if block.settings.show_inventory_quantity -%}
                            {{-
                              'products.product.inventory_in_stock_show_count'
                              | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                            -}}
                          {%- else -%}
                            {{- 'products.product.inventory_in_stock' | t -}}
                          {%- endif -%}
                        {%- endif -%}
                      {%- else -%}
                        {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                          <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                        {%- else -%}
                          <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {{- 'products.product.inventory_out_of_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}
                  </p>
                {%- when 'delivery_estimate' -%}
                  {%- liquid
                    assign delivery_summary_icon = block.settings.summary_icon | default: 'truck'
                    assign delivery_order_icon = block.settings.order_icon | default: 'checkmark'
                    assign delivery_ship_icon = block.settings.ship_icon | default: 'truck'
                    assign delivery_arrival_icon = block.settings.arrival_icon | default: 'box'
                  -%}
                  <tg-delivery-estimate
                    class="tg-delivery-estimate"
                    style="--tg-delivery-icon-background: {{ block.settings.icon_background_color | default: '#c9f2f8' }}; --tg-delivery-icon-color: {{ block.settings.svg_icon_color | default: '#087edb' }}; --tg-delivery-timeline-color: {{ block.settings.icon_line_color | default: '#18bfe5' }};"
                    data-day-mode="{{ block.settings.day_mode }}"
                    data-processing-min="{{ block.settings.processing_min_days }}"
                    data-processing-max="{{ block.settings.processing_max_days }}"
                    data-transit-min="{{ block.settings.transit_min_days }}"
                    data-transit-max="{{ block.settings.transit_max_days }}"
                    {{ block.shopify_attributes }}
                  >
                    <p class="tg-delivery-estimate__summary">
                      <span class="svg-wrapper" aria-hidden="true">{{- delivery_summary_icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}</span>
                      <span>
                        {{ block.settings.summary_prefix | escape }}
                        <strong data-delivery-range>Calculating...</strong>
                        {{ block.settings.summary_suffix | escape }}
                      </span>
                    </p>
                    <ol class="tg-delivery-estimate__steps">
                      <li class="tg-delivery-estimate__step">
                        <span class="tg-delivery-estimate__icon">{{- delivery_order_icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}</span>
                        <strong data-order-date></strong>
                        <small>{{ block.settings.order_label | escape }}</small>
                      </li>
                      <li class="tg-delivery-estimate__step">
                        <span class="tg-delivery-estimate__icon">{{- delivery_ship_icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}</span>
                        <strong data-ship-range></strong>
                        <small>{{ block.settings.ship_label | escape }}</small>
                      </li>
                      <li class="tg-delivery-estimate__step">
                        <span class="tg-delivery-estimate__icon">{{- delivery_arrival_icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}</span>
                        <strong data-delivery-step-range></strong>
                        <small>{{ block.settings.delivery_label | escape }}</small>
                      </li>
                    </ol>
                  </tg-delivery-estimate>
                {%- when 'sales_proof' -%}
                  <div class="tg-sales-proof" {{ block.shopify_attributes }}>
                    {%- if block.settings.sales_text != blank -%}
                      <p class="tg-sales-proof__count">
                        {{ block.settings.sales_text }}
                      </p>
                    {%- endif -%}
                    {%- unless section.settings.enable_tg_product_style -%}
                    {%- if block.settings.assurance_text != blank -%}
                      <ul class="tg-sales-proof__assurances">
                        {%- assign assurances = block.settings.assurance_text | split: '|' -%}
                        {%- for item in assurances -%}
                          <li>
                            <span class="svg-wrapper" aria-hidden="true">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                            {{ item | strip }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                    {%- endunless -%}
                  </div>
                {%- when 'volume_discount' -%}
                  {%- assign volume_discount_tier_count = block.settings.tier_count | default: 3 | plus: 0 -%}
                  {%- assign volume_discount_has_tier = false -%}
                  {%- assign volume_discount_visible_tier_count = 0 -%}
                  {%- if volume_discount_tier_count >= 1 -%}
                    {%- unless block.settings.tier_1_quantity == blank and block.settings.tier_1_discount == blank -%}
                      {%- assign volume_discount_has_tier = true -%}
                      {%- assign volume_discount_visible_tier_count = volume_discount_visible_tier_count | plus: 1 -%}
                    {%- endunless -%}
                  {%- endif -%}
                  {%- if volume_discount_tier_count >= 2 -%}
                    {%- unless block.settings.tier_2_quantity == blank and block.settings.tier_2_discount == blank -%}
                      {%- assign volume_discount_has_tier = true -%}
                      {%- assign volume_discount_visible_tier_count = volume_discount_visible_tier_count | plus: 1 -%}
                    {%- endunless -%}
                  {%- endif -%}
                  {%- if volume_discount_tier_count >= 3 -%}
                    {%- unless block.settings.tier_3_quantity == blank and block.settings.tier_3_discount == blank -%}
                      {%- assign volume_discount_has_tier = true -%}
                      {%- assign volume_discount_visible_tier_count = volume_discount_visible_tier_count | plus: 1 -%}
                    {%- endunless -%}
                  {%- endif -%}
                  {%- if volume_discount_tier_count >= 4 -%}
                    {%- unless block.settings.tier_4_quantity == blank and block.settings.tier_4_discount == blank -%}
                      {%- assign volume_discount_has_tier = true -%}
                      {%- assign volume_discount_visible_tier_count = volume_discount_visible_tier_count | plus: 1 -%}
                    {%- endunless -%}
                  {%- endif -%}
                  {%- if block.settings.heading != blank and volume_discount_has_tier -%}
                    <section
                      class="tg-volume-discount tg-volume-discount--tiers-{{ volume_discount_visible_tier_count }}"
                      style="--tg-volume-discount-columns: {{ volume_discount_visible_tier_count }}; --tg-volume-discount-background: {{ block.settings.background_color }}; --tg-volume-discount-tier-background: {{ block.settings.tier_background_color }}; --tg-volume-discount-border: {{ block.settings.border_color }}; --tg-volume-discount-text: {{ block.settings.text_color }}; --tg-volume-discount-title-color: {{ block.settings.title_color | default: block.settings.text_color }}; --tg-volume-discount-accent: {{ block.settings.accent_color }}; --tg-volume-discount-radius: {{ block.settings.corner_radius }}px; --tg-volume-discount-title-size: {{ block.settings.title_size }}px; --tg-volume-discount-body-size: {{ block.settings.body_size }}px; --tg-volume-discount-mobile-body-size: {{ block.settings.mobile_body_size | default: 12 }}px; --tg-volume-discount-spacing: {{ block.settings.vertical_spacing }}px;"
                      {{ block.shopify_attributes }}
                    >
                      {%- if section.settings.enable_tg_product_style -%}
                      <details class="tg-volume-discount__details">
                        <summary class="tg-volume-discount__summary">
                          <span class="svg-wrapper" aria-hidden="true">{{ 'tg-cart-promotion.svg' | inline_asset_content }}</span>
                          <span>{{ block.settings.heading | escape }}</span>
                          <span class="svg-wrapper tg-volume-discount__caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
                        </summary>
                      {%- else -%}
                      <div class="tg-volume-discount__title">
                        <span aria-hidden="true"></span>
                        <h2>{{ block.settings.heading | escape }}</h2>
                        <span aria-hidden="true"></span>
                      </div>
                      {%- endif -%}
                      <ul class="tg-volume-discount__tiers" role="list">
                        {%- if volume_discount_tier_count >= 1 -%}
                          {%- unless block.settings.tier_1_quantity == blank and block.settings.tier_1_discount == blank -%}
                            <li class="tg-volume-discount__tier">
                              {%- if block.settings.tier_1_quantity != blank -%}
                                <span>{{ block.settings.tier_1_quantity | escape }}</span>
                              {%- endif -%}
                              {%- if block.settings.tier_1_discount != blank -%}
                                <strong>{{ block.settings.tier_1_discount | escape }}</strong>
                              {%- endif -%}
                            </li>
                          {%- endunless -%}
                        {%- endif -%}
                        {%- if volume_discount_tier_count >= 2 -%}
                          {%- unless block.settings.tier_2_quantity == blank and block.settings.tier_2_discount == blank -%}
                            <li class="tg-volume-discount__tier">
                              {%- if block.settings.tier_2_quantity != blank -%}
                                <span>{{ block.settings.tier_2_quantity | escape }}</span>
                              {%- endif -%}
                              {%- if block.settings.tier_2_discount != blank -%}
                                <strong>{{ block.settings.tier_2_discount | escape }}</strong>
                              {%- endif -%}
                            </li>
                          {%- endunless -%}
                        {%- endif -%}
                        {%- if volume_discount_tier_count >= 3 -%}
                          {%- unless block.settings.tier_3_quantity == blank and block.settings.tier_3_discount == blank -%}
                            <li class="tg-volume-discount__tier">
                              {%- if block.settings.tier_3_quantity != blank -%}
                                <span>{{ block.settings.tier_3_quantity | escape }}</span>
                              {%- endif -%}
                              {%- if block.settings.tier_3_discount != blank -%}
                                <strong>{{ block.settings.tier_3_discount | escape }}</strong>
                              {%- endif -%}
                            </li>
                          {%- endunless -%}
                        {%- endif -%}
                        {%- if volume_discount_tier_count >= 4 -%}
                          {%- unless block.settings.tier_4_quantity == blank and block.settings.tier_4_discount == blank -%}
                            <li class="tg-volume-discount__tier">
                              {%- if block.settings.tier_4_quantity != blank -%}
                                <span>{{ block.settings.tier_4_quantity | escape }}</span>
                              {%- endif -%}
                              {%- if block.settings.tier_4_discount != blank -%}
                                <strong>{{ block.settings.tier_4_discount | escape }}</strong>
                              {%- endif -%}
                            </li>
                          {%- endunless -%}
                        {%- endif -%}
                      </ul>
                      {%- if section.settings.enable_tg_product_style -%}</details>{%- endif -%}
                    </section>
                  {%- endif -%}
                {%- when 'tg_product_addon' -%}
                  {%- assign addon_product = block.settings.product -%}
                  {%- if addon_product != blank and addon_product.selected_or_first_available_variant != blank -%}
                    {%- assign addon_variant_id = block.settings.variant_id | default: addon_product.selected_or_first_available_variant.id -%}
                    <div
                      class="tg-product__addon"
                      data-tg-addon
                      data-variant-id="{{ addon_variant_id }}"
                      data-title="{{ addon_product.title | escape }}"
                      data-error-message="{{ block.settings.error_message | escape }}"
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.heading != blank -%}<strong>{{ block.settings.heading | escape }}</strong>{%- endif -%}
                      <label>
                        <input type="checkbox" data-tg-addon-toggle {% unless addon_product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                        {%- if addon_product.featured_image != blank -%}
                          {{ addon_product.featured_image | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: '72px', loading: 'lazy', alt: addon_product.title }}
                        {%- endif -%}
                        <span>
                          <b>{{ addon_product.title | escape }}</b>
                          <span>{{ addon_product.selected_or_first_available_variant.price | money }}</span>
                          {%- if block.settings.description != blank -%}<small>{{ block.settings.description | escape }}</small>{%- endif -%}
                        </span>
                      </label>
                    </div>
                  {%- endif -%}
                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- endif -%}
                {%- when 'sku' -%}
                  <p
                    class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                    id="Sku-{{ section.id }}"
                    role="status"
                    {{ block.shopify_attributes }}
                  >
                    <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                    {{- product.selected_or_first_available_variant.sku -}}
                  </p>
                {%- when 'custom_liquid' -%}
                  {{ block.settings.custom_liquid }}
                {%- when 'collapsible_tab' -%}
                  {%- capture accordion_content -%}
                    {%- case block.settings.content_source -%}
                      {%- when 'product_description' -%}
                        {{ product.description }}
                      {%- when 'page' -%}
                        {{ block.settings.page.content }}
                      {%- else -%}
                        {{ block.settings.content }}
                        {{ block.settings.page.content }}
                    {%- endcase -%}
                  {%- endcapture -%}
                  <div
                    class="product__accordion accordion quick-add-hidden tg-product-accordion"
                    style="--tg-accordion-title-size: {{ block.settings.title_font_size | default: 13 | divided_by: 10.0 }}rem; --tg-accordion-title-size-mobile: {{ block.settings.title_font_size_mobile | default: 11 | divided_by: 10.0 }}rem; --tg-accordion-title-weight: {{ block.settings.title_font_weight | default: '600' }}; --tg-accordion-title-color: {{ block.settings.title_color | default: '#202024' }};"
                    {{ block.shopify_attributes }}
                  >
                    <details id="Details-{{ block.id }}-{{ section.id }}"{% if block.settings.open_by_default %} open{% endif %}>
                      <summary>
                        <div class="summary__title">
                          {% if block.settings.icon != 'none' %}{% render 'icon-accordion', icon: block.settings.icon %}{% endif %}
                          <h2 class="h4 accordion__title inline-richtext">
                            {{ block.settings.heading | default: block.settings.page.title | escape }}
                          </h2>
                        </div>
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </summary>
                      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                        {{ accordion_content }}
                      </div>
                    </details>
                  </div>
                {%- when 'quantity_selector' -%}
                  {%- unless inline_purchase_actions -%}
                    {% render 'tg-product-quantity', block: block, product: product, product_form_id: product_form_id, section: section %}
                  {%- endunless -%}
                {%- when 'popup' -%}
                  <modal-opener
                    class="product-popup-modal__opener quick-add-hidden"
                    data-modal="#PopupModal-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <button
                      id="ProductPopup-{{ block.id }}"
                      class="product-popup-modal__button link"
                      type="button"
                      aria-haspopup="dialog"
                    >
                      {{ block.settings.text | default: block.settings.page.title | escape }}
                    </button>
                  </modal-opener>
                {%- when 'share' -%}
                  {% liquid
                    assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                    render 'share-button', block: block, share_link: share_url
                  %}

                {%- when 'disclosures' -%}
                  {%- render 'product-disclosures',
                    product: product,
                    heading: block.settings.heading,
                    heading_size: block.settings.heading_size,
                    open_by_default: block.settings.open_by_default,
                    block: block,
                    surface: 'product_page'
                  -%}
                {%- when 'variant_picker' -%}
                  {% render 'product-variant-picker',
                    product: product,
                    block: block,
                    product_form_id: product_form_id
                  %}
                {%- when 'buy_buttons' -%}
                  {%- render 'buy-buttons',
                    block: block,
                    product: product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    quantity_block: quantity_selector_block,
                    inline_purchase_actions: inline_purchase_actions,
                    show_pickup_availability: true,
                    requires_customization: tg_requires_customization,
                    customization_loading_text: tg_customization_guard_loading_text
                  -%}
                  {%- if section.settings.enable_tg_product_style -%}
                    {%- assign tg_assurance_block = section.blocks | where: 'type', 'sales_proof' | first -%}
                    <div class="tg-product-assurances">
                      {%- if tg_assurance_block.settings.assurance_text != blank -%}
                        <ul class="tg-sales-proof__assurances" role="list">
                          {%- assign assurances = tg_assurance_block.settings.assurance_text | split: '|' -%}
                          {%- for item in assurances -%}
                            {%- assign assurance = item | strip -%}
                            {%- if assurance != blank -%}
                              <li><span class="svg-wrapper" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>{{ assurance | escape }}</li>
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                      {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                      {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        {{ form | payment_terms }}
                      {%- endform -%}
                    </div>
                  {%- endif -%}
                {%- when 'trust_message' -%}
                  <div class="tg-trust-message" {{ block.shopify_attributes }}>
                    <span class="svg-wrapper" aria-hidden="true">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                    <div>
                      <strong>{{ block.settings.heading | escape }}</strong>
                      {%- if block.settings.text != blank -%}
                        <div class="rte">{{ block.settings.text }}</div>
                      {%- endif -%}
                      {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="link underlined-link">{{ block.settings.link_label | escape }}</a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- when 'rating' -%}
                  {%- if product.metafields.reviews.rating.value != blank -%}
                    <div class="rating-wrapper">
                      {% liquid
                        assign rating_decimal = 0
                        assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                        if decimal >= 0.3 and decimal <= 0.7
                          assign rating_decimal = 0.5
                        elsif decimal > 0.7
                          assign rating_decimal = 1
                        endif
                      %}
                      <div
                        class="rating"
                        role="img"
                        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                      >
                        <span
                          aria-hidden="true"
                          class="rating-star"
                          style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                        ></span>
                      </div>
                      <p class="rating-text caption">
                        <span aria-hidden="true">
                          {{- product.metafields.reviews.rating.value }} /
                          {{ product.metafields.reviews.rating.value.scale_max -}}
                        </span>
                      </p>
                      <p class="rating-count caption">
                        <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                        <span class="visually-hidden">
                          {{- product.metafields.reviews.rating_count }}
                          {{ 'accessibility.total_reviews' | t -}}
                        </span>
                      </p>
                    </div>
                  {%- endif -%}
                {%- when 'complementary' -%}
                  <product-recommendations
                    class="complementary-products quick-add-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}"
                    data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.product_list_limit }}&intent=complementary"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                  >
                    {%- if recommendations.performed and recommendations.products_count > 0 -%}
                      <aside
                        aria-label="{{ 'accessibility.complementary_products' | t }}"
                        {{ block.shopify_attributes -}}
                        {% if block.settings.make_collapsible_row %}
                          class="product__accordion accordion"
                        {% endif %}
                      >
                        <div class="complementary-products__container">
                          {%- if block.settings.make_collapsible_row -%}
                            <details id="Details-{{ block.id }}-{{ section.id }}" open>
                              <summary>
                          {%- endif %}
                          <div class="summary__title">
                            {%- if block.settings.make_collapsible_row -%}
                              {% render 'icon-accordion', icon: block.settings.icon %}
                              <h2 class="h4 accordion__title">{{ block.settings.block_heading }}</h2>
                            {%- else -%}
                              <h2 class="h3 accordion__title">{{ block.settings.block_heading }}</h2>
                            {%- endif -%}
                          </div>
                          {%- if block.settings.make_collapsible_row -%}
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                            </summary>
                          {%- endif -%}
                          <slideshow-component class="slider-mobile-gutter">
                            {%- assign number_of_slides = recommendations.products_count
                              | plus: 0.0
                              | divided_by: block.settings.products_per_page
                              | ceil
                            -%}
                            <div
                              id="Slider-{{ block.id }}"
                              class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere"
                              role="list"
                              {% if number_of_slides > 1 %}
                                aria-label="{{ 'general.slider.name' | t }}"
                              {% endif %}
                            >
                              {% assign skip_card_product_styles = false %}
                              {%- for i in (1..number_of_slides) -%}
                                <div
                                  id="Slide-{{ block.id }}-{{ forloop.index }}"
                                  class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide"
                                  tabindex="-1"
                                  role="group"
                                  {% if number_of_slides > 1 %}
                                    aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                    aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                  {% endif %}
                                >
                                  <ul class="list-unstyled" role="list">
                                    {%- for product in recommendations.products
                                      limit: block.settings.products_per_page
                                      offset: continue
                                    -%}
                                      <li>
                                        {%- if block.settings.enable_quick_add -%}
                                          {% assign quick_add = 'standard' %}
                                        {%- else -%}
                                          {% assign quick_add = 'none' %}
                                        {%- endif -%}
                                        {% render 'card-product',
                                          card_product: product,
                                          media_aspect_ratio: block.settings.image_ratio,
                                          show_secondary_image: false,
                                          lazy_load: false,
                                          skip_styles: skip_card_product_styles,
                                          quick_add: quick_add,
                                          section_id: section.id,
                                          horizontal_class: true,
                                          horizontal_quick_add: true
                                        %}
                                      </li>
                                      {%- assign skip_card_product_styles = true -%}
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              {%- endfor -%}
                            </div>
                            {%- if number_of_slides > 1 -%}
                              <div class="slider-buttons">
                                <button
                                  type="button"
                                  class="slider-button slider-button--prev"
                                  name="previous"
                                  aria-label="{{ 'general.slider.previous_slide' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-caret.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                  {%- if block.settings.pagination_style == 'counter' -%}
                                    <span class="slider-counter--current">1</span>
                                    <span aria-hidden="true"> / </span>
                                    <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                    <span class="slider-counter--total">{{ number_of_slides }}</span>
                                  {%- else -%}
                                    <div class="slideshow__control-wrapper">
                                      {%- for i in (1..number_of_slides) -%}
                                        <button
                                          class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link"
                                          aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                          aria-controls="Slider-{{ block.id }}"
                                        >
                                          {%- if block.settings.pagination_style == 'numbers' -%}
                                            {{ forloop.index -}}
                                          {%- else -%}
                                            <span class="dot"></span>
                                          {%- endif -%}
                                        </button>
                                      {%- endfor -%}
                                    </div>
                                  {%- endif -%}
                                </div>
                                <button
                                  type="button"
                                  class="slider-button slider-button--next"
                                  name="next"
                                  aria-label="{{ 'general.slider.next_slide' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-caret.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                              </div>
                            {%- endif -%}
                          </slideshow-component>
                          {%- if block.settings.make_collapsible_row -%}
                            </details>
                          {%- endif -%}
                        </div>
                      </aside>
                    {%- endif -%}
                    {{ 'component-card.css' | asset_url | stylesheet_tag }}
                    {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                    {%- if block.settings.enable_quick_add -%}
                      {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                      <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                    {%- endif -%}
                  </product-recommendations>
                {%- when 'icon-with-text' -%}
                  {% render 'icon-with-text', block: block %}
              {%- endcase -%}
            {%- endfor -%}
            <a href="{{ product.url }}" class="link product__view-details animate-arrow">
              {{ 'products.product.view_full_details' | t }}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </a>
          </section>
        </div>
      </div>

      {% render 'product-media-modal', variant_images: variant_images %}

      {% assign popups = section.blocks | where: 'type', 'popup' %}
      {%- for block in popups -%}
        <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
          <div
            role="dialog"
            aria-label="{{ block.settings.text }}"
            aria-modal="true"
            class="product-popup-modal__content"
            tabindex="-1"
          >
            <button
              id="ModalClose-{{ block.id }}"
              type="button"
              class="product-popup-modal__toggle"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
            <div class="product-popup-modal__content-info">
              <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
              {{ block.settings.page.content }}
            </div>
          </div>
        </modal-dialog>
      {%- endfor -%}

      {%- if tg_size_chart_active -%}
        <modal-dialog id="SizeChartModal-{{ section.id }}" class="product-popup-modal tg-size-chart__modal">
          <div
            role="dialog"
            aria-modal="true"
            aria-labelledby="SizeChartTitle-{{ section.id }}"
            class="product-popup-modal__content tg-size-chart__dialog"
            tabindex="-1"
          >
            <button
              id="ModalClose-SizeChart-{{ section.id }}"
              type="button"
              class="product-popup-modal__toggle"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
            <div class="product-popup-modal__content-info tg-size-chart__content">
              <h2 id="SizeChartTitle-{{ section.id }}" class="h2 tg-size-chart__title">
                {{- tg_size_chart_button_label | escape -}}
              </h2>
              {%- if tg_size_chart_image != blank -%}
                {%- assign tg_size_chart_alt = tg_size_chart_image.alt | default: tg_size_chart_button_label -%}
                {{
                  tg_size_chart_image
                  | image_url: width: 2200
                  | image_tag:
                    widths: '375, 550, 750, 900, 1100, 1400, 1800, 2200',
                    sizes: '(min-width: 990px) 84rem, (min-width: 750px) 70vw, 92vw',
                    loading: 'eager',
                    class: 'tg-size-chart__image',
                    alt: tg_size_chart_alt
                }}
              {%- endif -%}
              {%- if tg_size_chart_image_2 != blank -%}
                {%- assign tg_size_chart_alt_2 = tg_size_chart_image_2.alt | default: tg_size_chart_button_label -%}
                {{
                  tg_size_chart_image_2
                  | image_url: width: 2200
                  | image_tag:
                    widths: '375, 550, 750, 900, 1100, 1400, 1800, 2200',
                    sizes: '(min-width: 990px) 84rem, (min-width: 750px) 70vw, 92vw',
                    loading: 'eager',
                    class: 'tg-size-chart__image',
                    alt: tg_size_chart_alt_2
                }}
              {%- endif -%}
            </div>
          </div>
        </modal-dialog>
      {%- endif -%}

      {%- if product.media.size > 0 -%}
