  {{ 'tg-product.css' | asset_url | stylesheet_tag }}
  {{ 'tg-product-page.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-discount.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
