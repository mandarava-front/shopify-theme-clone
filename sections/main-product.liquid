        </script>
        <script src="{{ 'product-model.js' | asset_url }}" defer></script>
      {%- endif -%}

      {%- liquid
        if product.selected_or_first_available_variant.featured_media
          assign seo_media = product.selected_or_first_available_variant.featured_media
        else
          assign seo_media = product.featured_media
        endif
      -%}

      <script type="application/ld+json">
        {{ product | structured_data }}
      </script>
    </div>
  </product-component>
</product-info>

<script>
  if (!customElements.get('tg-delivery-estimate')) {
    customElements.define('tg-delivery-estimate', class extends HTMLElement {
      connectedCallback() {
        const mode = this.dataset.dayMode;
        const processingMin = Number(this.dataset.processingMin);
        const processingMax = Math.max(processingMin, Number(this.dataset.processingMax));
        const transitMin = Number(this.dataset.transitMin);
        const transitMax = Math.max(transitMin, Number(this.dataset.transitMax));
        const today = new Date();
        today.setHours(12, 0, 0, 0);

        const shipMin = this.addDays(today, processingMin, mode);
        const shipMax = this.addDays(today, processingMax, mode);
        const deliveryMin = this.addDays(shipMin, transitMin, mode);
        const deliveryMax = this.addDays(shipMax, transitMax, mode);

        this.querySelector('[data-order-date]').textContent = this.formatDate(today);
        this.querySelector('[data-ship-range]').textContent = this.formatRange(shipMin, shipMax);
        this.querySelector('[data-delivery-range]').textContent = this.formatRange(deliveryMin, deliveryMax);
        this.querySelector('[data-delivery-step-range]').textContent = this.formatRange(deliveryMin, deliveryMax);
      }

      addDays(start, days, mode) {
        const date = new Date(start);
        if (mode === 'calendar') {
          date.setDate(date.getDate() + days);
          return date;
        }

        let remaining = days;
        while (remaining > 0) {
          date.setDate(date.getDate() + 1);
          if (date.getDay() !== 0 && date.getDay() !== 6) remaining -= 1;
        }
        return date;
      }

      formatDate(date) {
        return new Intl.DateTimeFormat(document.documentElement.lang || 'en', {
          month: 'short',
          day: 'numeric'
        }).format(date);
      }

      formatRange(start, end) {
        return `${this.formatDate(start)} - ${this.formatDate(end)}`;
      }
    });
  }
</script>

