{%- liquid
  assign tg_size_chart_active = false
  assign tg_size_chart_has_image = false
  assign tg_size_chart_image = settings.tg_size_chart_image
  assign tg_size_chart_image_2 = settings.tg_size_chart_image_2
  assign tg_size_chart_trigger_tag = settings.tg_size_chart_trigger_tag | default: 'size-chart' | strip | downcase
  assign tg_size_chart_option_names = settings.tg_size_chart_option_names | default: 'Size,尺码,尺寸'
  assign tg_size_chart_button_label = settings.tg_size_chart_button_label | strip | default: 'Size Chart'
  # TeeInBlue calls a Campaign by Shopify products a "platform product", so a
  # TeeInBlue product without that metafield is a Campaign by Product Bases.
  # campaign_version is written for every TeeInBlue product, Product Bases or
  # not, so it is what separates a campaign from a plain product here.
  assign tg_teeinblue_product_base = false
  if product.metafields.teeinblue.campaign_version.value != blank
    if product.metafields.teeinblue.platform_product.value == blank
      assign tg_teeinblue_product_base = true
    endif
  endif

  # Lock every product in server-rendered HTML; the plugins decide applicability.
  assign tg_requires_customization = false
  assign tg_customization_guard_timeout = settings.tg_customization_guard_timeout | default: 20
  assign tg_customization_guard_loading_text = settings.tg_customization_guard_loading_text | strip
  assign tg_customization_guard_error_text = settings.tg_customization_guard_error_text | strip
  if tg_customization_guard_loading_text == blank
    assign tg_customization_guard_loading_text = 'Loading options...'
  endif
  if tg_customization_guard_error_text == blank
    assign tg_customization_guard_error_text = "Couldn't load customization options. Please refresh the page."
  endif
  if settings.tg_customization_guard_enabled != false
    assign tg_requires_customization = true
  endif

  if tg_size_chart_image != blank
    assign tg_size_chart_has_image = true
  endif
  if tg_size_chart_image_2 != blank
    assign tg_size_chart_has_image = true
  endif

  if settings.tg_size_chart_enabled != false
    if tg_size_chart_trigger_tag != blank
      if tg_size_chart_has_image
        for product_tag in product.tags
          assign normalized_product_tag = product_tag | strip | downcase
          if normalized_product_tag == tg_size_chart_trigger_tag
            assign tg_size_chart_active = true
            break
          endif
        endfor
      endif
    endif
  endif
-%}

<product-info
