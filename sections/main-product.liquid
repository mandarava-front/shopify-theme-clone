  data-update-url="true"
  data-url="{{ product.url }}"
  {% if tg_teeinblue_product_base %}
    data-tg-teeinblue-product-base
  {% endif %}
  {% if tg_requires_customization %}
    data-tg-requires-customization
    data-tg-customization-guard="pending"
    data-tg-customization-timeout="{{ tg_customization_guard_timeout }}"
    data-tg-customization-loading="{{ tg_customization_guard_loading_text | escape }}"
